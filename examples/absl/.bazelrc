# Refuse to auto-detect a host C++ toolchain, so that a failure to resolve the
# bootstrapped one is loud rather than silently papered over by /usr/bin/cc.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Do not let the host environment into actions.
build --incompatible_strict_action_env

# Abseil and GoogleTest are C++17. GCC 10 defaults to gnu++14.
build --cxxopt=-std=c++17

build --verbose_failures
test --test_output=errors

# Bazel's own test runner is a bash script, and --incompatible_strict_action_env
# above pins PATH to /bin:/usr/bin:/usr/local/bin, where a NixOS machine has
# nothing. Without the real PATH every cc_test dies with exit 127.
test --test_env=PATH
