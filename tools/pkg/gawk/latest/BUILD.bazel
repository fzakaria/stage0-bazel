"""GNU awk 5.3.2, built by GNU awk 3.0.6. BUILDS, BUT MISCOMPILED.

It builds and passes the tests below, and it is still wrong: length()
returns 1 for every string.

    $ echo abc | gawk '{ print length($0), length("hello"), substr("hello",2,3) }'
    1 1                                     # should be: 3 5 ell

The string data itself is intact -- `print $0` reproduces the whole record,
and $1 is the right field -- so what is wrong is the length gawk has
recorded for a string, not the bytes. It is wrong for a constant written in
the program text, so it is not about reading input either.

Through that, autoconf's subs.awk loses the left-hand side of every
substitution, because it assembles each line as
substr(line, 1, length(field[1])) value substr(...):

    build_alias = @build_alias@      ->      x86_64-unknown-linux-gnu

and make rejects the result with "missing separator".

Disabling gawk's multibyte path (mbrtowc, wctype.h) does not change it, so
this is not the character-versus-byte counting that broke sed's regex. It is
the same family as the memset fault -- the program is correct and the
compiler is not -- but the specific miscompilation has not been found.

So GCC is blocked from both directions: gawk 3.0.6 gets options.h wrong and
gawk 5.3.2 gets config.status wrong.


GCC generates its options.h with an awk script, and gawk 3.0.6 gets the
arithmetic wrong:

    #define OPTION_MASK_ISA_64BIT (1 << 2.08617e-07)

a float where a bit index belongs, which stops the GCC build at
gcc/config/i386/i386.h:539. A newer awk is the fix.
"""

load("//tools/pkg:configure.bzl", "LIBC_HEADERS_TOOLCHAIN", "configure_package")
load("//tools/pkg:defs.bzl", "installed_program")
load("//tools/stage0:files.bzl", "tool_dir")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

configure_package(
    name = "gawk_dist",
    tarball = "@gawk-latest-src//file",
    prefix = "gawk-5.3.2",
    libc_headers = LIBC_HEADERS_TOOLCHAIN,
    configure_flags = [
        "--build=x86_64-unknown-linux-gnu",
        "--host=x86_64-unknown-linux-gnu",
        "--disable-dependency-tracking",
        "--disable-nls",
        # Extensions are loaded at run time, and there is no dynamic loader.
        "--disable-extensions",
    ],
    exports = [
        "AR=\"tcc -ar\"",
        "RANLIB=true",
        "LD=tcc",
    ],
    # gawk's own configure comes from a modern autoconf too, so the old awk
    # has to carry its replacement through its build, and a sed that gets the
    # config.status substitution script right has to be on PATH ahead of the
    # bootstrap one. That is the step still missing; see
    # tools/pkg/gnused/latest.
    tools = [
        "//tools/pkg/bash/latest:bin",
        "//tools/pkg/gnused/latest:bin",
        "//tools/pkg/gawk:bin",
    ],
)

installed_program(
    name = "gawk",
    package = ":gawk_dist",
    program = "gawk",
)

tool_dir(
    name = "bin",
    tools = {
        "gawk": ":gawk",
        "awk": ":gawk",
    },
)

program_output_test(
    name = "gawk_field_test",
    program = ":gawk",
    arguments = ["'{ print $2 }'"],
    stdin = "alpha beta gamma",
    expected_output = "beta",
)

# The construct 3.0.6 could not parse: a string assignment continued onto the
# next line, which is what autoconf's subs.awk is made of.
program_output_test(
    name = "gawk_continuation_test",
    program = ":gawk",
    arguments = ["'BEGIN { S[\"key\"]=\\\n\"value\"; print S[\"key\"] }'"],
    expected_output = "value",
)
