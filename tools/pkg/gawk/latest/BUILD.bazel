"""GNU awk 5.3.2, built by GNU awk 3.0.6. BUILDS, BUT MISCOMPILED.

It builds and passes the tests below, and it is still wrong. Running
autoconf's subs.awk over GCC's Makefile.in, every substituted line comes out
as the bare value with its left-hand side gone:

    build_alias = @build_alias@      ->      x86_64-unknown-linux-gnu

which make then rejects with "missing separator". subs.awk builds each line
as substr(line, 1, len) value substr(line, len + keylen + 3) where
len = length(field[1]), so a length() or substr() returning the wrong thing
produces exactly this. That is the same family of fault as the memset and
regex bugs already found: the program is fine, the compiler is not.

So GCC cannot use this yet either. gawk 3.0.6 gets options.h wrong and this
one gets config.status wrong.


GCC generates its options.h with an awk script, and gawk 3.0.6 gets the
arithmetic wrong:

    #define OPTION_MASK_ISA_64BIT (1 << 2.08617e-07)

a float where a bit index belongs, which stops the GCC build at
gcc/config/i386/i386.h:539. A newer awk is the fix.
"""

load("//tools/pkg:configure.bzl", "LIBC_HEADERS_TOOLCHAIN", "configure_package")
load("//tools/pkg:defs.bzl", "installed_program")
load("//tools/stage0:files.bzl", "tool_dir")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

configure_package(
    name = "gawk_dist",
    tarball = "@gawk-latest-src//file",
    prefix = "gawk-5.3.2",
    libc_headers = LIBC_HEADERS_TOOLCHAIN,
    configure_flags = [
        "--build=x86_64-unknown-linux-gnu",
        "--host=x86_64-unknown-linux-gnu",
        "--disable-dependency-tracking",
        "--disable-nls",
        # Extensions are loaded at run time, and there is no dynamic loader.
        "--disable-extensions",
    ],
    exports = [
        "AR=\"tcc -ar\"",
        "RANLIB=true",
        "LD=tcc",
    ],
    # gawk's own configure comes from a modern autoconf too, so the old awk
    # has to carry its replacement through its build, and a sed that gets the
    # config.status substitution script right has to be on PATH ahead of the
    # bootstrap one. That is the step still missing; see
    # tools/pkg/gnused/latest.
    tools = [
        "//tools/pkg/bash/latest:bin",
        "//tools/pkg/gnused/latest:bin",
        "//tools/pkg/gawk:bin",
    ],
)

installed_program(
    name = "gawk",
    package = ":gawk_dist",
    program = "gawk",
)

tool_dir(
    name = "bin",
    tools = {
        "gawk": ":gawk",
        "awk": ":gawk",
    },
)

program_output_test(
    name = "gawk_field_test",
    program = ":gawk",
    arguments = ["'{ print $2 }'"],
    stdin = "alpha beta gamma",
    expected_output = "beta",
)

# The construct 3.0.6 could not parse: a string assignment continued onto the
# next line, which is what autoconf's subs.awk is made of.
program_output_test(
    name = "gawk_continuation_test",
    program = ":gawk",
    arguments = ["'BEGIN { S[\"key\"]=\\\n\"value\"; print S[\"key\"] }'"],
    expected_output = "value",
)
