"""GNU sed 4.2, built by GNU sed 4.0.9.

sed 4.0.9 cannot run the `N` command when its input is stdin. Given a script
that joins pairs of lines it emits the first and stops:

    $ sed -f join.sed < pairs.txt
    k1=

The same file passed by name works. autoconf assembles config.status by
piping one sed into another, so this truncated every generated makefile and
surfaced much later as an awk parse error on the half-written result. That is
the whole reason this package exists.

4.2 was itself wrong until musl's memset was fixed -- `.` matched only the
first few character codes, because gnulib builds its regex fastmap with
memset(fastmap, 1, 256). See tools/pkg/musl.
"""

load("//tools/pkg:configure.bzl", "LIBC_HEADERS_TOOLCHAIN", "configure_package")
load("//tools/pkg:defs.bzl", "installed_program")
load("//tools/stage0:files.bzl", "tool_dir")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

configure_package(
    name = "gnused_dist",
    tarball = "@gnused-latest-src//file",
    prefix = "sed-4.2",
    libc_headers = LIBC_HEADERS_TOOLCHAIN,
    configure_flags = [
        "--build=x86_64-unknown-linux-gnu",
        "--host=x86_64-unknown-linux-gnu",
        "--disable-shared",
        "--disable-nls",
        "--disable-dependency-tracking",
    ],
    exports = [
        "AR=\"tcc -ar\"",
        "RANLIB=true",
        "LD=tcc",
    ],
    make_flags = ["AR=\"tcc -ar\""],
    tools = ["//tools/pkg/gawk:bin"],
)

installed_program(
    name = "sed",
    package = ":gnused_dist",
    program = "sed",
)

tool_dir(
    name = "bin",
    tools = {"sed": ":sed"},
)

program_output_test(
    name = "gnused_substitute_test",
    program = ":sed",
    arguments = ["-e", "'s/before/after/'"],
    stdin = "a line that says before",
    expected_output = "a line that says after",
)

# The two things this build had to get right: a whole-line match, and the
# N command reading from stdin. Both are what autoconf's config.status
# pipeline depends on.
# A whole-line match over uppercase input: the shape that failed while
# musl's memset was truncating the regex fastmap.
program_output_test(
    name = "gnused_whole_line_match_test",
    program = ":sed",
    arguments = ["'s/.*/[&]/'"],
    stdin = "ABCdef",
    expected_output = "[ABCdef]",
)

# N reading from stdin, which 4.0.9 could not do. The script is autoconf's:
# a line not starting with a quote absorbs the line after it.
program_output_test(
    name = "gnused_next_line_from_stdin_test",
    program = ":sed",
    arguments = ["-e", "'/^[^\"]/{'", "-e", "N", "-e", "'s/\\n//'", "-e", "}"],
    stdin = "k1=\n\"v1\"\nk2=\n\"v2\"",
    expected_output = "k1=\"v1\"\nk2=\"v2\"",
)
