"""GNU binutils 2.46.

The assembler, linker and archiver GCC needs. tinycc has its own of all
three, but GCC will not use them: it emits assembly for gas and drives ld
directly.

This is the first package built with the musl tinycc rather than the mes-libc
one, and it is where a complete C library starts to pay for itself.

Three things it needs that earlier packages did not: bash 5.3, because
autoconf 2.72 emits shell that bash 2.05b mis-parses inside eval; the sed
from tools/pkg/gnused/latest, because config.status is assembled by one sed
piped into another and sed 4.0.9 cannot run N on stdin; and a raised
lt_cv_sys_max_cmd_len, because tcc -ar cannot append to an archive.

The recipe and both patches are nixpkgs' minimal-bootstrap binutils.
"""

load("//tools/pkg:configure.bzl", "LIBC_HEADERS_TOOLCHAIN", "configure_package")
load("//tools/pkg:defs.bzl", "installed_program")
load("//tools/stage0:files.bzl", "tool_dir")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

PATCHES = [
    # ansidecl.h defines __attribute__ away for compilers older than GCC 2.7,
    # and tinycc reports a version that lands in that range while in fact
    # supporting the attributes. Losing them turns into an mmap assertion
    # failure much later.
    "patches/fix-tinycc-attribute.patch",
    # Make ld's output deterministic without being asked.
    "patches/deterministic.patch",
]

configure_package(
    name = "binutils",
    tarball = "@binutils-src//file",
    prefix = "binutils-2.46.0",
    compression = "xz",
    libc_headers = LIBC_HEADERS_TOOLCHAIN,
    patches = ["tools/pkg/binutils/" + patch for patch in PATCHES],
    patch_labels = PATCHES,
    # binutils is what provides ar and ranlib, so its own build cannot use
    # them. tinycc is its own archiver and writes the index as it goes, which
    # is what ranlib would otherwise add.
    exports = [
        "AR=\"tcc -ar\"",
        "RANLIB=true",
        # libtool builds a large archive in batches, calling $AR once per
        # batch and relying on `ar r` meaning insert-or-replace. tcc -ar does
        # not: it reopens the archive with "wb" every time, so each batch
        # throws away the one before it and the finished library is missing
        # everything but the last. libbfd came out 1.3 MB with no bfd_init in
        # it. Raising the command-length libtool believes it has keeps the
        # archive to a single call.
        "lt_cv_sys_max_cmd_len=8388608",
    ],
    # The documentation is built by makeinfo, which does not exist in this
    # bootstrap and is not wanted. `true` accepts the arguments and writes
    # nothing, which is what the info rules need to succeed.
    make_flags = ["MAKEINFO=true"],
    # Staged, as nixpkgs does. binutils links its own libraries into its
    # tools, and tinycc reads an archive once in the order it is given, so
    # the libraries have to be finished before anything links against them.
    build_targets = [
        "all-libiberty all-bfd all-libctf all-zlib all-opcodes all-gas all-gprof",
        "all-ld",
        "",
    ],
    # config.status runs awk, and the generated makefiles use it too.
    # bash 5.3 first: autoconf 2.72 emits shell that bash 2.05b mis-parses
    # inside eval, and configure_package takes whichever bash PATH finds.
    tools = [
        "//tools/pkg/bash/latest:bin",
        "//tools/pkg/gnused/latest:bin",
        "//tools/pkg/gawk:bin",
    ],
    configure_flags = [
        "--build=x86_64-unknown-linux-gnu",
        "--host=x86_64-unknown-linux-gnu",
        "--with-sysroot=/",
        "--disable-dependency-tracking",
        "--disable-nls",
        "--enable-deterministic-archives",
        "--disable-gprofng",
        "--enable-new-dtags",
        "--with-lib-path=:",
        "--disable-gold",
        "--disable-plugins",
    ],
)

PROGRAMS = [
    "ar",
    "as",
    "ld",
    "nm",
    "objcopy",
    "objdump",
    "ranlib",
    "readelf",
    "strip",
]

[
    installed_program(
        name = program,
        package = ":binutils",
        program = program,
        )
    for program in PROGRAMS
]

tool_dir(
    name = "bin",
    tools = {program: ":" + program for program in PROGRAMS},
)

# The linker GCC will be told to use, reporting itself.
program_output_test(
    name = "binutils_ld_test",
    program = ":ld",
    arguments = ["--version"],
    expected_output = """GNU ld (GNU Binutils) 2.46.0.20260210
Copyright (C) 2026 Free Software Foundation, Inc.
This program is free software; you may redistribute it under the terms of
the GNU General Public License version 3 or (at your option) a later version.
This program has absolutely no warranty.""",
)

