"""GCC 10.4.0, built by the GCC 4.6.4 this repository produced.

4.6 is where both reference bootstraps stop, because it is the last release
that a compiler as limited as tinycc can build. It gives C++98 and enough of
C++0x to prove the chain works, and not enough to be worth shipping: LLVM
sets LLVM_REQUIRED_CXX_STANDARD to 17, and so does most C++ written since.

10.4 is the first release in this chain that provides C++17, and the last one
that 4.6 can build -- GCC 11 raised its own requirement to a C++11 compiler.
10.5 is not usable either: it miscompiles when built by 4.6, which is GCC
PR 110716. The recipe is nixpkgs' minimal-bootstrap gcc/10.nix.

Where this departs from nixpkgs: they link against a shared musl and name its
dynamic loader, and there is no shared musl here, so everything is static.
The four support libraries are unpacked as siblings and symlinked in, which
is how GCC's configure finds and builds them in-tree; isl is new at 10.4,
4.6 had no use for it.

Only one of the two patches the 4.6 packages need applies here.
install-headers-cp.patch still does, for the same reason -- there is still no
tar in this bootstrap that can write an archive. no-system-headers.patch does
not: 4.6 hard-coded NATIVE_SYSTEM_HEADER_DIR to /usr/include in its
Makefile.in, and by 10.4 it is an autoconf substitution that
--with-native-system-header-dir sets, so there is nothing left to patch out.
"""

load("//tools/pkg:configure.bzl", "LIBC_HEADERS_NONE", "configure_package")
load("//tools/pkg:defs.bzl", "installed_program")
load("//tools/pkg/gcc:defs.bzl", "MERGE_LIBSUPCXX_INTO_LIBSTDCXX", "stamp_support_libraries")
load("//tools/stage0:kaem.bzl", "MAKE_PARALLEL")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

# The versions of the four libraries GCC builds in-tree. They appear in the
# symlink names below, which is the whole reason configure finds them.
GMP_VERSION = "6.2.1"

MPFR_VERSION = "4.2.2"

MPC_VERSION = "1.3.1"

ISL_VERSION = "0.24"

configure_package(
    name = "gcc_latest_dist",
    tarball = "@gcc-latest-src//file",
    prefix = "gcc-10.4.0",
    compression = "xz",
    libc_headers = LIBC_HEADERS_NONE,
    # GCC finds cc1, cc1plus and its own libraries relative to the path it was
    # invoked by, so both compilers have to be named inside the installed tree
    # of the 4.6 that is building this one. -static because musl here has no
    # shared objects and there is no dynamic loader for a program to name.
    cc = "$root/$gcc/bin/gcc",
    cc_flags = [
        "-static",
        "-B$root/$musl/lib",
    ],
    extra_directories = {
        "gcc": "//tools/pkg/gcc/cxx:gcc_cxx_dist",
        "musl": "//tools/pkg/musl:musl3",
    },
    extra_tarballs = {
        "gmp": "@gmp-latest-src//file",
        "isl": "@isl-src//file",
        "mpc": "@mpc-latest-src//file",
        "mpfr": "@mpfr-latest-src//file",
    },
    # 4.6's support libraries were all gzip. These are two xz, one bzip2 and
    # one gzip, so each says which it is.
    extra_tarball_compression = {
        "gmp": "xz",
        "isl": "bz2",
        "mpfr": "xz",
    },
    patches = ["//tools/pkg/gcc:patches/install-headers-cp.patch"],
    extra_setup = [
        # configure builds these in-tree when it finds them under these names,
        # and they are unpacked as siblings.
        "ln -s ../gmp-%s gmp" % GMP_VERSION,
        "ln -s ../mpfr-%s mpfr" % MPFR_VERSION,
        "ln -s ../mpc-%s mpc" % MPC_VERSION,
        "ln -s ../isl-%s isl" % ISL_VERSION,
    ] + stamp_support_libraries(["gmp", "mpfr", "mpc", "isl"]) + [
        # mpfr generates this file by running tools/get_patches.sh over the
        # patch files it ships, and it ships none. Writing the result directly
        # is what the 4.6 packages do; mpfr 4.x moved it under src/.
        "printf 'const char *mpfr_get_patches (void) { return \"\"; }\n' > mpfr/src/get_patches.c",
        # 10.4 still does not know musl, so a *-linux-musl host falls through
        # to the gnu-linux case and libstdc++ compiles against glibc's
        # os_defines.h. os/generic is the one that assumes nothing.
        "sed -i -e 's|\"os/gnu-linux\"|\"os/generic\"|' libstdc++-v3/configure.host",
    ],
    exports = [
        # The C++ compiler that builds this one. GCC has needed a C++ compiler
        # to build itself since 4.8; 10.4 wants C++98, which 4.6 has, and 11
        # would want C++11, which it does not.
        "CXX=\"$root/$gcc/bin/g++ -static -B$root/$musl/lib\"",
        # binutils, rather than `tcc -ar`: there is a real assembler and a
        # real linker by now, and libstdc++ needs an archive index.
        "AR=ar",
        "RANLIB=ranlib",
        # Without these configure defaults both to "-g -O2", and the debug
        # info for a whole GCC is far larger than the compiler it describes.
        "CFLAGS=-O2",
        "CXXFLAGS=-O2",
        # Where musl's headers are. The compiler cannot be told at configure
        # time, because the path it would record is inside the build sandbox
        # and does not exist afterwards; see
        # --with-native-system-header-dir below. mpfr's sources include each
        # other by bare name during the in-tree build.
        "C_INCLUDE_PATH=\"$root/$musl/include:$PWD/mpfr/src\"",
        "CPLUS_INCLUDE_PATH=\"$C_INCLUDE_PATH\"",
        # GCC adds this to both its startfile and its library search, which is
        # what makes crt1.o and libc.a findable.
        "LIBRARY_PATH=\"$root/$musl/lib\"",
        "lt_cv_shlibpath_overrides_runpath=yes",
        # As in the 4.6 stages: --disable-dependency-tracking does not reach
        # every subdirectory configure, and gcc3 is the only dependency style
        # GCC's own macro accepts.
        "enable_dependency_tracking=no",
        "am_cv_CC_dependencies_compiler_type=gcc3",
        "am_cv_CXX_dependencies_compiler_type=gcc3",
    ],
    configure_flags = [
        "--build=x86_64-unknown-linux-gnu",
        "--host=x86_64-unknown-linux-gnu",
        # Deliberately a path that does not exist. A real one would be inside
        # the build sandbox: GCC relocates the directories under its own
        # prefix by comparing them against where it finds itself, but a system
        # header directory outside the prefix is recorded verbatim and would
        # point at a sandbox that is gone. Callers name musl's headers
        # themselves -- see //toolchain.
        "--with-native-system-header-dir=/include",
        # Where those headers actually are while this is being built. 4.6 got
        # away with naming a directory that does not exist because its
        # no-system-headers.patch emptied the variable outright; 10.4 keeps
        # the variable and checks it, and stops when it is missing:
        #
        #     The directory that should contain system headers does not exist:
        #       /include
        #     make[2]: *** [Makefile:3165: stmp-fixinc] Error 1
        #
        # --with-build-sysroot is the flag for exactly this. GCC's own
        # documentation is explicit that it "affects only the build, not the
        # installed compiler", so fixincludes gets a real directory to read
        # and nothing records a path that will not exist afterwards.
        "--with-build-sysroot=$root/$musl",
        "--enable-languages=c,c++",
        "--enable-checking=release",
        "--disable-bootstrap",
        "--disable-dependency-tracking",
        "--disable-libatomic",
        "--disable-libgomp",
        "--disable-libitm",
        "--disable-libquadmath",
        "--disable-libsanitizer",
        "--disable-libssp",
        "--disable-libstdcxx-pch",
        "--disable-libvtv",
        "--disable-lto",
        "--disable-lto-plugin",
        "--disable-multilib",
        "--disable-nls",
        "--disable-plugin",
        # musl here is static only.
        "--enable-static",
        "--disable-shared",
    ],
    make_flags = ["MAKEINFO=true"],
    post_install_commands = MERGE_LIBSUPCXX_INTO_LIBSTDCXX,
    # By far the longest build in this repository: a whole GCC, with C++,
    # compiled by a 2011 compiler that is itself several stages of bootstrap
    # deep. GCC's makefiles are parallel-safe and this is where the time is.
    # -j needs the make whose jobserver works; see //tools/pkg/gnumake/latest.
    make_concurrency = MAKE_PARALLEL,
    tools = [
        "//tools/pkg/gnumake/latest:bin",
        "//tools/pkg/binutils:bin",
        "//tools/pkg/bash/latest:bin",
        "//tools/pkg/gnused/latest:bin",
        "//tools/pkg/gawk/latest:bin",
        "//tools/pkg/diffutils:bin",
        # New at 10.4: its build walks directories with find, and nothing
        # before this needed one.
        "//tools/pkg/findutils:bin",
    ],
)

installed_program(
    name = "gcc",
    package = ":gcc_latest_dist",
    program = "gcc",
)

installed_program(
    name = "g++",
    package = ":gcc_latest_dist",
    program = "g++",
)

# -dumpfullversion rather than the -dumpversion the 4.6 packages use: since
# GCC 7 -dumpversion reports the major version alone, so it would answer "10"
# here and could not tell 10.4.0 from any other 10.x.
program_output_test(
    name = "gcc_latest_version_test",
    program = ":g++",
    arguments = ["-dumpfullversion"],
    expected_output = "10.4.0",
)
