"""GCC 4.6.4, C only.

The last GCC release that can be built by a compiler as limited as tinycc,
which is why both reference bootstraps go through it. This stage builds the C
compiler; the C++ front end is unpacked with it so the same tree can be
reconfigured for C++ afterwards.

The recipe is nixpkgs' minimal-bootstrap gcc/4.6.nix. gmp, mpfr and mpc are
unpacked beside the GCC tree and linked into it under the names GCC's
top-level configure looks for, so it builds them in-tree.
"""

load("//tools/pkg:configure.bzl", "DECOMPRESS_GNU", "LIBC_HEADERS_TOOLCHAIN", "configure_package")
load("//tools/pkg/gcc:defs.bzl", "stamp_support_libraries")
load("//tools/pkg:defs.bzl", "installed_program")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

PATCHES = [
    # GCC's makefile hardcodes /usr/include as the native system header
    # directory. There is no /usr/include in this world, and picking one up
    # would end the bootstrap.
    "patches/no-system-headers.patch",
    # `make install` copies GCC's own headers with tar, and there is no tar
    # here that can write an archive.
    "patches/install-headers-cp.patch",
]

configure_package(
    name = "gcc_dist",
    tarball = "@gcc-core-src//file",
    prefix = "gcc-4.6.4",
    libc_headers = LIBC_HEADERS_TOOLCHAIN,
    decompressor = DECOMPRESS_GNU,
    extra_tarballs = {
        "gpp": "@gcc-gpp-src//file",
        "gmp": "@gmp-src//file",
        "mpfr": "@mpfr-src//file",
        "mpc": "@mpc-src//file",
    },
    patches = PATCHES,
    extra_setup = [
        # GCC's configure builds these in-tree when it finds them under these
        # names. They are unpacked as siblings, so the links point up.
        "ln -s ../gmp-4.3.2 gmp",
        "ln -s ../mpfr-2.4.2 mpfr",
        "ln -s ../mpc-1.0.3 mpc",
    ] + stamp_support_libraries(["gmp", "mpfr", "mpc"]) + [
        # mpfr generates this from its PATCHES file, which the release
        # tarball does not carry. The contents are only reported by
        # mpfr_get_patches(), which nothing in a GCC build calls.
        "printf 'const char *mpfr_get_patches (void) { return \"\"; }\n' > mpfr/get_patches.c",
    ],
    exports = [
        "AR=\"tcc -ar\"",
        "RANLIB=true",
        "CFLAGS=-O2",
        # mpfr's sources include each other by bare name during the in-tree
        # build, and the compiler's own headers have to stay reachable.
        "C_INCLUDE_PATH=\"$root/$toolchain/include:$PWD/mpfr/src\"",
        "CPLUS_INCLUDE_PATH=\"$C_INCLUDE_PATH\"",
        "lt_cv_shlibpath_overrides_runpath=yes",
        # Probes that need to run a linked program to answer, which a build
        # like this cannot do. These are the answers for Linux.
        "ac_cv_func_memcpy=yes",
        "ac_cv_func_strerror=yes",
        # tcc -ar rewrites an archive rather than appending to it, so libtool
        # must not build one in batches. See tools/pkg/binutils.
        "lt_cv_sys_max_cmd_len=8388608",
        # --disable-dependency-tracking is passed at the top level but does
        # not reach every subdirectory configure, and those that miss it stop
        # with "no usable dependency style found". configure treats an
        # exported enable_* variable as if the flag had been given, so this
        # reaches all of them.
        "enable_dependency_tracking=no",
        # And answer the dependency-style probe directly. GCC's own
        # ZW_PROG_COMPILER_DEPENDENCIES treats a style of "none" as a fatal
        # error rather than as "do not track", so gcc3 is the only usable
        # answer; tinycc was taught -MT for it. See tools/tcc/current.
        "am_cv_CC_dependencies_compiler_type=gcc3",
        "am_cv_CXX_dependencies_compiler_type=gcc3",
    ],
    configure_flags = [
        "--build=x86_64-unknown-linux-gnu",
        "--host=x86_64-unknown-linux-gnu",
        "--with-native-system-header-dir=/include",
        "--enable-checking=release",
        "--disable-bootstrap",
        "--disable-decimal-float",
        "--disable-dependency-tracking",
        "--disable-libatomic",
        "--disable-libgomp",
        "--disable-libitm",
        "--disable-libmudflap",
        "--disable-libquadmath",
        "--disable-libsanitizer",
        "--disable-libssp",
        "--disable-lto",
        "--disable-lto-plugin",
        "--disable-multilib",
        "--disable-nls",
        "--disable-plugin",
        "--disable-threads",
        "--enable-languages=c",
        "--enable-static",
        "--disable-shared",
        "--enable-threads=single",
        "--disable-libstdcxx-pch",
        "--disable-build-with-cxx",
    ],
    make_flags = ["MAKEINFO=true"],
    install_target = "install",
    tools = [
        "//tools/pkg/bash/latest:bin",
        "//tools/pkg/gnused/latest:bin",
        "//tools/pkg/gawk/latest:bin",
        "//tools/pkg/binutils:bin",
        # cmp, for the documentation rules; see tools/pkg/diffutils.
        "//tools/pkg/diffutils:bin",
    ],
)

# The driver alone, for checking what it reports. It cannot compile anything
# on its own: GCC finds cc1 relative to the path it was invoked by, so an
# actual build has to name bin/gcc inside gcc_dist. See tools/pkg/musl's
# third round for what that looks like.
installed_program(
    name = "gcc",
    package = ":gcc_dist",
    program = "gcc",
)

program_output_test(
    name = "gcc_version_test",
    program = ":gcc",
    arguments = ["-dumpversion"],
    expected_output = "4.6.4",
)
