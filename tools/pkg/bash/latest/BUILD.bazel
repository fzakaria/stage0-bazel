"""bash 5.3, built by bash 2.05b.

2.05b is from 2002 and autoconf is now 2.72. The shell it emits is beyond the
older one in ways that only show up inside `eval`:

    ./configure: eval: line 1: unexpected EOF while looking for matching `\''

so every configure past this point needs a current shell. 2.05b's job was to
get from kaem to here, and this is the last thing it builds.

It needs the sed from tools/pkg/gnused/latest, because config.status is
assembled by one sed piped into another and sed 4.0.9 cannot run N on stdin.

This used to fail about half the time, at the link, with symbols from
builtins/libbuiltins.a undefined -- internal_getopt, reset_internal_getopt,
lcurrent, loptend -- and was worked around by retrying make up to four times.
The archive was never the problem: on a failing run libbuiltins.a was
complete and contained the symbol.

It was tinycc, and the fault was in the C library underneath it. mes-libc's
qsort left an element equal to the pivot on the wrong side of the partition,
and tccgen.c sorts a switch statement's cases and then binary-searches the
result to emit the dispatch. A misordered table compiles a wide switch into
code that takes the wrong branch, which is as arbitrary a fault as it sounds.
See tools/mes/mes-libc/qsort.c.

The retry is gone. Eight from-scratch builds since the fix have all linked
first time.
"""

load("//tools/pkg:configure.bzl", "DECOMPRESS_GNU", "LIBC_HEADERS_TOOLCHAIN", "configure_package")
load("//tools/pkg:defs.bzl", "installed_program")
load("//tools/stage0:files.bzl", "tool_dir")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

PATCHES = [
    # mksignames writes its generated file without flushing, and the build
    # reads it back straight away.
    "patches/mksignames-flush.patch",
]

configure_package(
    name = "bash_dist",
    tarball = "@bash-latest-src//file",
    prefix = "bash-5.3",
    libc_headers = LIBC_HEADERS_TOOLCHAIN,
    # mescc-tools-extra's inflate cannot read this tarball: it stops with
    # "puff() failed with return code -2".
    decompressor = DECOMPRESS_GNU,
    patches = PATCHES,
    configure_flags = [
        "--build=x86_64-unknown-linux-gnu",
        "--host=x86_64-unknown-linux-gnu",
        "--disable-dependency-tracking",
        "--disable-nls",
        # bash's bundled malloc uses assembly and layout assumptions that do
        # not survive this compiler; musl's is fine.
        "--without-bash-malloc",
    ],
    exports = [
        "AR=\"tcc -ar\"",
        "RANLIB=true",
        "LD=tcc",
    ],
    # A sed that gets autoconf's config.status substitution script right has
    # to come ahead of the bootstrap one; see tools/pkg/gnused/latest.
    tools = [
        "//tools/pkg/gnused/latest:bin",
        "//tools/pkg/gawk:bin",
    ],
)

installed_program(
    name = "bash",
    package = ":bash_dist",
    program = "bash",
)

# Later packages call the shell as `sh` as well as `bash`; upstream installs a
# symlink for it, and naming the same program twice does the same job.
tool_dir(
    name = "bin",
    tools = {
        "bash": ":bash",
        "sh": ":bash",
    },
)

program_output_test(
    name = "bash_test",
    program = ":bash",
    arguments = ["-c", "'echo shell works'"],
    expected_output = "shell works",
)

# += is bash 3.1 and later. autoconf uses it in as_fn_append, and 2.05b
# answers that with a syntax error inside eval, which is what made every
# modern configure script unusable.
program_output_test(
    name = "bash_append_operator_test",
    program = ":bash",
    arguments = ["-c", "'v=one; v+=two; echo $v'"],
    expected_output = "onetwo",
)
