"""GNU patch, the first upstream package the bootstrap builds.

It comes first because every package after it needs its patches applied, and
because it is small enough to build without a Makefile: the flags below stand
in for ./configure, which cannot run until there is a shell.

The flag and source lists are nixpkgs' minimal-bootstrap gnupatch/default.nix,
which took them in turn from live-bootstrap. Backslashes before quotes are
kaem escapes: kaem treats a bare " as a quote delimiter, so a flag whose value
is a string literal has to escape them.
"""

load("//tools/pkg:defs.bzl", "installed_program", "tcc_package")
load("//tools/stage0:files.bzl", "tool_dir")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

tcc_package(
    name = "gnupatch",
    tarball = "@gnupatch-src//file",
    prefix = "patch-2.5.9",
    binary = "patch",
    cflags = [
        "-I patch-2.5.9",
        "-DHAVE_DECL_GETENV",
        "-DHAVE_DECL_MALLOC",
        "-DHAVE_DIRENT_H",
        "-DHAVE_LIMITS_H",
        "-DHAVE_GETEUID",
        "-DHAVE_MKTEMP",
        "-DPACKAGE_BUGREPORT=",
        "-Ded_PROGRAM=\\\"/nullop\\\"",
        "-Dmbstate_t=int",
        "-DRETSIGTYPE=int",
        "-DHAVE_MKDIR",
        "-DHAVE_RMDIR",
        "-DHAVE_FCNTL_H",
        "-DPACKAGE_NAME=\\\"patch\\\"",
        "-DPACKAGE_VERSION=\\\"2.5.9\\\"",
        "-DHAVE_MALLOC",
        "-DHAVE_REALLOC",
        "-DSTDC_HEADERS",
        "-DHAVE_STRING_H",
        "-DHAVE_STDLIB_H",
        "-DHAVE_VPRINTF",
    ],
    # ./configure would write config.h. Nothing in it is needed, and catm with
    # a single argument creates the empty file the sources expect.
    configure = ["catm patch-2.5.9/config.h"],
    sources = [
        "addext.c",
        "argmatch.c",
        "backupfile.c",
        "basename.c",
        "dirname.c",
        "getopt.c",
        "getopt1.c",
        "inp.c",
        "maketime.c",
        "partime.c",
        "patch.c",
        "pch.c",
        "quote.c",
        "quotearg.c",
        "quotesys.c",
        "util.c",
        "version.c",
        "xmalloc.c",
        "error.c",
    ],
)

installed_program(
    name = "patch",
    package = ":gnupatch",
    program = "patch",
)

# The form later packages put on PATH.
tool_dir(
    name = "bin",
    tools = {"patch": ":patch"},
)

program_output_test(
    name = "gnupatch_version_test",
    program = ":patch",
    arguments = ["--version"],
    expected_output = """patch 2.5.9
Copyright (C) 1988 Larry Wall
Copyright (C) 2003 Free Software Foundation, Inc.

This program comes with NO WARRANTY, to the extent permitted by law.
You may redistribute copies of this program
under the terms of the GNU General Public License.
For more information about these matters, see the file named COPYING.

written by Larry Wall and Paul Eggert""",
)
