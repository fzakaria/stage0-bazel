"""The mes C library, compiled by mescc.

These are the source lists from upstream's build-aux/configure-lib.sh for
mes_libc=mes, mes_kernel=linux, mes_cpu=x86_64 and compiler=mescc. The shape
of the output directory matters: mescc looks for crt1.o and lib*.a under
`<library dir>/x86_64-mes/`, which is where mescc_object and mescc_library
put them.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//tools/stage0:mescc.bzl", "mescc_archive", "mescc_object")

package(
    default_visibility = ["//visibility:public"],
)

# mescc names a library search directory by a file inside it, and this
# directory otherwise holds only generated subdirectories. The marker gives
# the toolchain something to point at.
write_file(
    name = "libdir_marker",
    out = "MESCC_LIBDIR",
    content = ["mescc library search directory"],
)

# The C runtime startup object. Its name is fixed: mescc links `crt1.o` under
# exactly that name unless -nostartfiles is given.
mescc_object(
    name = "crt1",
    src = "@mes-m2//:lib/linux/x86_64-mes-mescc/crt1.c",
    hdrs = ["@mes-m2//:headers"],
    toolchain = "//tools/mes:mescc_bootstrap",
)

# libmescc holds the pieces every mescc-compiled program needs; mescc links
# it by default alongside libc.
mescc_archive(
    name = "libmescc",
    library_name = "mescc",
    srcs = [
        "@mes-m2//:lib/mes/globals.c",
        "@mes-m2//:lib/linux/x86_64-mes-mescc/syscall-internal.c",
    ],
    hdrs = ["@mes-m2//:headers"],
    toolchain = "//tools/mes:mescc_bootstrap",
)

