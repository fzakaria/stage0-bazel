"""The mes C library as tinycc consumes it.

tinycc has no notion of a source list: it compiles one translation unit and
links archives. Upstream's build therefore concatenates the whole library into
a single libc.c, which is what `build-aux/build-source-lib.sh` does and what
`catm` does here.

These are the "gcc" variants of the sources rather than the "mescc" ones. The
difference is only in the syscall stubs, and tinycc handles the gcc form; this
is the same choice nixpkgs' minimal-bootstrap makes.

The file list comes from nixpkgs' mes/sources.json, key x86_64.linux.gcc,
which is `libc_gnu_SOURCES` from upstream's configure-lib.sh already expanded.
"""

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("//tools/stage0:catm.bzl", "cat_files")
load("//tools/stage0:files.bzl", "relocate_files")

package(
    default_visibility = ["//visibility:public"],
)

# tinycc on x86-64 passes variadic arguments through a register save area,
# and mes's stdarg.h models va_list as a plain char* -- the i386 convention.
# The two cannot both be on the include path, so tinycc's headers win and
# these two sources have to stop depending on mes's.
#
# va_arg8 exists only in mes's stdarg.h. The has_l bookkeeping replaces it:
# under the x86-64 ABI an int and a long occupy different amounts of the
# argument area, so `%d` and `%ld` have to be read differently, which mes's
# version did not distinguish.
#
# Both patches are taken from nixpkgs' minimal-bootstrap mes/default.nix.
_PRINTF_SUBSTITUTIONS = {
    "int count = 0;": "int count = 0; int has_l = 0;",
    "long d = va_arg (ap, long);": """
          long d;
          if (has_l) {
            has_l = 0;
            d = va_arg (ap, long);
          } else if (c != 'd' && c != 'i') {
            d = (long) (va_arg (ap, unsigned int));
          } else {
            d = (long) (va_arg (ap, int));
          }
        """,
    "if (c == 'l')": """
          if (c == 'l') {
            has_l = 1;
            c = *++p;
          } else if (0)""",
    "va_arg8": "va_arg",
}

# _exit loads the syscall number into %rax and only then moves its argument
# into %rdi. tinycc satisfies the "rm" constraint with %rax, so the argument
# read is really `mov %rax,%rdi` and every program exits with the syscall
# number -- 0x3c, 60 -- instead of its own status. Loading %rdi first is
# correct whichever register the constraint picks.
# The two asm lines, exactly as they appear in the source. Single quotes keep
# the embedded double quotes readable; \\n is the two characters a C string
# escape occupies in the file.
_LOAD_RAX = '"mov     $"SYS_exit",%%rax\\n\\t"'

_LOAD_RDI = '"mov     %0,%%rdi\\n\\t"'

_SEPARATOR = "\n       "

expand_template(
    name = "exit_patched",
    template = "@mes-m2//:lib/linux/x86_64-mes-gcc/_exit.c",
    out = "patched/_exit.c",
    substitutions = {
        _LOAD_RAX + _SEPARATOR + _LOAD_RDI: _LOAD_RDI + _SEPARATOR + _LOAD_RAX,
    },
)

[
    expand_template(
        name = name + "_patched",
        template = "@mes-m2//:lib/stdio/%s.c" % name,
        out = "patched/%s.c" % name,
        substitutions = _PRINTF_SUBSTITUTIONS,
    )
    for name in [
        "vfprintf",
        "vsnprintf",
    ]
]

