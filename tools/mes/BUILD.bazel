    "@mes-m2//:lib/mes/fdputc.c",
    "@mes-m2//:lib/mes/eputc.c",
    "@mes-m2//:include/time.h",
    "@mes-m2//:include/sys/time.h",
    "@mes-m2//:include/m2/types.h",
    "@mes-m2//:include/sys/types.h",
    "@mes-m2//:include/sys/utsname.h",
