"""Build mes from M2-Planet

GNU Mes is a Scheme interpreter and C compiler for bootstrapping the GNU System.
"""

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//tools/stage0:hex2_1.bzl", "hex2_binary")
load("//tools/stage0:m1.bzl", "m1_expand")
load("//tools/stage0:m2.bzl", "m2_compile")
load("//tools/stage0:bloodelf.bzl", "blood_elf")
load("//tools/stage0:mes.bzl", "mes_distribution", "mes_scheme_test")
load("//tools/mes:headers.bzl", "MES_ARCH_HEADER_FIXES", "MES_HEADER_FIXES")
load("//tools/stage0:files.bzl", "patched_tree", "relocate_files")
load("//tools/stage0:mescc.bzl", "mescc_toolchain")

package(
    default_visibility = ["//visibility:public"],
)

# Upstream generates this header from ./configure. Reproducing the two lines
# it actually contains keeps configure -- and the shell it needs -- out of the
# bootstrap. MES_VERSION must match the archive named in MODULE.bazel.
#
# It lands under include/mes/ so the same directory can serve as a -I root for
# mescc, which expects to find <mes/config.h> there.
write_file(
    name = "config_h",
    out = "include/mes/config.h",
    content = [
        "#undef SYSTEM_LIBC",
        "#define MES_VERSION \"0.27\"",
    ],
)

# mescc names an include directory by a file inside it; config.h sits one
# level deeper, so this marker names the directory itself.
write_file(
    name = "includedir_marker",
    out = "include/MESCC_INCLUDEDIR",
    content = ["mescc include search directory"],
)

# mes-libc implements several functions its headers never declare, which on
# x86-64 truncates their returned pointers. See headers.bzl.
patched_tree(
    name = "headers",
    srcs = ["@mes-m2//:headers"],
    prefix = "headers",
    substitutions = MES_HEADER_FIXES,
)

write_file(
    name = "headers_marker",
    out = "headers/include/MES_INCLUDEDIR",
    content = ["mes include search directory"],
)

filegroup(
    name = "header_dir",
    srcs = [
        ":headers",
        ":headers/include/MES_INCLUDEDIR",
    ],
)

# Mes source includes <arch/syscall.h> and expects the build to have put the
# headers for the chosen target there. Upstream's ./configure copies them; the
# same selection is made here by naming the x86_64 directory directly.
#
# kernel-stat.h is corrected on the way through: its struct stat does not
# match what the kernel writes. See headers.bzl.
relocate_files(
    name = "arch_headers",
    srcs = [
        "@mes-m2//:include/linux/x86_64/kernel-stat.h",
        "@mes-m2//:include/linux/x86_64/signal.h",
        "@mes-m2//:include/linux/x86_64/syscall.h",
    ],
    prefix = "include/arch",
    substitutions = MES_ARCH_HEADER_FIXES,
)

# The directory the arch headers live under, as one target: the marker names
# the directory and the headers make it non-empty. Anything compiling mes
# source needs this on its include path alongside mes's own include/.
filegroup(
    name = "arch_include_dir",
    srcs = [
        ":arch_headers",
        # mes/lib-mini.h includes <mes/config.h>, so the generated header has
        # to travel with the arch headers rather than only being on the
        # include path.
        ":include/mes/config.h",
        ":include/MESCC_INCLUDEDIR",
    ],
)


