    }),
    is_debug = True,
    compiler = "@//tools/stage0/phase15:M2-Planet",
    defines = {
        "__linux__" : "1",
        "__x86_64__" : "1",
    },
)

blood_elf(
    name = "mes-footer.M1",
    src = ":mes.M1",
    is_little_endian = select({
        "@bazel_tools//src/conditions:linux_x86_64": True,
    }),
    is_64 = True,
)
m1_expand(
    name = "mes.hex2",
    srcs = select(
        {
            "@bazel_tools//src/conditions:linux_x86_64": [
                # do not sort
                "@mes-m2//:lib/m2/x86_64/x86_64_defs.M1",
                "@mes-m2//:lib/x86_64-mes/x86_64.M1",
                "@mes-m2//:lib/linux/x86_64-mes-m2/crt1.M1",
            ],
        },
    ) + [
        ":mes.M1",
        ":mes-footer.M1",
    ],
    architecture = select({
        "@bazel_tools//src/conditions:linux_x86_64": "amd64",
    }),
    is_little_endian = select({
        "@bazel_tools//src/conditions:linux_x86_64": True,
    }),
    tool = "//tools/stage0/phase9:M1"
)

hex2_binary(
    name = "mes-m2-internal",
    srcs = select(
        {
            "@bazel_tools//src/conditions:linux_x86_64": [
                # do not sort
                "@mes-m2//:lib/m2/x86_64/ELF-x86_64.hex2",
            ],
        },
    ) + [
        ":mes.hex2",
    ],
    base_address = "0x1000000",
    architecture = select({
        "@bazel_tools//src/conditions:linux_x86_64": "amd64",
    }),
    is_little_endian = select({
        "@bazel_tools//src/conditions:linux_x86_64": True,
    }),
    tool = "//tools/stage0/phase8:hex2-1",
)

mes_distribution(
    name = "mes",
    interpreter = ":mes-m2-internal",
    runtime_files = ["@mes-m2//:runtime_files"],
)

# The interpreter is only useful once it can find and evaluate its own Scheme,
# so booting it is the real test that the stage0 hand-off worked.
mes_scheme_test(
    name = "mes_boot_test",
    mes = ":mes",
    expression = "(display %version)(newline)(display (map (lambda (x) (* x x)) (list 1 2 3)))(newline)",
)

# mescc's driver is a configure template. Only the target description has to
# be filled in: every other placeholder is guarded by a string-prefix? test
# that treats an unsubstituted value as "not set", and the paths those would
# supply are passed on the command line instead.
expand_template(
    name = "mescc_scm",
    out = "mescc.scm",
    template = "@mes-m2//:scripts/mescc.scm.in",
    substitutions = {
        "@mes_cpu@": "x86_64",
        "@mes_kernel@": "linux",
        "@VERSION@": "0.27",
    },
)

mescc_toolchain(
    name = "mescc",
    mes = ":mes",
    driver = ":mescc.scm",
    nyacc = "@nyacc//:runtime_files",
    assembler = "//tools/stage0/phase9:M1",
    linker = "//tools/stage0/phase10:hex2",
    debug_tool = "//tools/stage0/phase13:blood-elf",
    catm = "//tools/stage0/phase2:catm",
    includes = [
        ":arch_headers",
        ":include/mes/config.h",
        "@mes-m2//:headers",
    ],
    include_dir_markers = [
        # Ours first, so the generated config.h wins over anything upstream
        # might ship under the same name.
        ":include/MESCC_INCLUDEDIR",
        "@mes-m2//:include/errno.h",
        "@mes-m2//:include/linux/x86_64/syscall.h",
    ],
    libraries = [
        "@mes-m2//:arch_support",
        "//tools/mes/lib:crt1",
        "//tools/mes/lib:libc",
        "//tools/mes/lib:libc_tcc",
        "//tools/mes/lib:libmescc",
    ],
    library_dir_markers = [
        # The libraries this repository builds, then the ELF fragments and M1
        # macro definitions that ship with mes.
        "//tools/mes/lib:MESCC_LIBDIR",
        "@mes-m2//:lib/libtcc1.c",
    ],
)

# A toolchain that can compile but not yet link, used to build the C library
# itself. Without it, libc would have to exist before it could be built.
mescc_toolchain(
    name = "mescc_bootstrap",
    mes = ":mes",
    driver = ":mescc.scm",
    nyacc = "@nyacc//:runtime_files",
    assembler = "//tools/stage0/phase9:M1",
    linker = "//tools/stage0/phase10:hex2",
    debug_tool = "//tools/stage0/phase13:blood-elf",
    catm = "//tools/stage0/phase2:catm",
    includes = [
        ":arch_headers",
        ":include/mes/config.h",
        "@mes-m2//:headers",
    ],
    include_dir_markers = [
        ":include/MESCC_INCLUDEDIR",
        "@mes-m2//:include/errno.h",
        "@mes-m2//:include/linux/x86_64/syscall.h",
    ],
    libraries = ["@mes-m2//:arch_support"],
    library_dir_markers = ["@mes-m2//:lib/libtcc1.c"],
)
