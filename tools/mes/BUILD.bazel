    "@mes-m2//:lib/mes/__init_io.c",
    "@mes-m2//:lib/linux/x86_64-mes-m2/_exit.c",
    "@mes-m2//:lib/linux/x86_64-mes-m2/_write.c",
    "@mes-m2//:lib/mes/globals.c",
    "@mes-m2//:lib/m2/cast.c",
    "@mes-m2//:lib/stdlib/exit.c",
    "@mes-m2//:lib/mes/write.c",
