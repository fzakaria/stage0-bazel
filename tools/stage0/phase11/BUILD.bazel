"""Phase 11 for Stage0: Build kaem from C sources

kaem is a deliberately tiny shell. Nothing earlier in the bootstrap needs it,
but everything after mes does: the build systems of tinycc, binutils and gcc
are shell scripts, and running them on a host shell would hand the whole
bootstrap back to the host.
"""

load("//tools/stage0:hex2_1.bzl", "hex2_binary")
load("//tools/stage0:m1.bzl", "m1_expand")
load("//tools/stage0:m2.bzl", "m2_compile")
load("//tools/stage0:bloodelf.bzl", "blood_elf")

package(
    default_visibility = ["//visibility:public"],
)

m2_compile(
    name = "kaem.M1",
    srcs = [
        # do not sort
        "@M2libc//:sys/types.h",
        "@M2libc//:stddef.h",
        "@M2libc//:string.c",
        "@M2libc//:sys/utsname.h",
    ] + select(
        {
            "@bazel_tools//src/conditions:linux_x86_64": [
                # do not sort
                "@M2libc//:x86/linux/unistd.c",
                "@M2libc//:x86/linux/fcntl.c",
            ],
        },
    ) + [
        # do not sort
        "@M2libc//:fcntl.c",
        "@M2libc//:stdlib.c",
        "@M2libc//:stdio.h",
        "@M2libc//:stdio.c",
        "@M2libc//:bootstrappable.c",
        "@mescc-tools//:Kaem/kaem.h",
        "@mescc-tools//:Kaem/variable.c",
        "@mescc-tools//:Kaem/kaem_globals.c",
        "@mescc-tools//:Kaem/kaem.c",
    ],
    architecture = select({
        "@bazel_tools//src/conditions:linux_x86_64": "x86",
    }),
    is_debug = True,
)

blood_elf(
    name = "kaem-footer.M1",
    src = ":kaem.M1",
    is_little_endian = select({
        "@bazel_tools//src/conditions:linux_x86_64": True,
    }),
    tool = "//tools/stage0/phase6:blood-elf-0",
)

m1_expand(
    name = "kaem.hex2",
    srcs = select(
        {
            "@bazel_tools//src/conditions:linux_x86_64": [
                # do not sort
                "@M2libc//:x86/x86_defs.M1",
                "@M2libc//:x86/libc-full.M1",
            ],
        },
    ) + [
        # do not sort
        ":kaem.M1",
        ":kaem-footer.M1",
    ],
    architecture = select({
        "@bazel_tools//src/conditions:linux_x86_64": "x86",
    }),
    is_little_endian = select({
        "@bazel_tools//src/conditions:linux_x86_64": True,
    }),
    tool = "//tools/stage0/phase9:M1",
)

hex2_binary(
    name = "kaem",
    srcs = select(
        {
            "@bazel_tools//src/conditions:linux_x86_64": [
                # do not sort
                "@M2libc//:x86/ELF-x86-debug.hex2",
            ],
        },
    ) + [
        ":kaem.hex2",
    ],
    base_address = "0x8048000",
    architecture = select({
        "@bazel_tools//src/conditions:linux_x86_64": "x86",
    }),
    is_little_endian = select({
        "@bazel_tools//src/conditions:linux_x86_64": True,
    }),
    tool = "//tools/stage0/phase8:hex2-1",
)
