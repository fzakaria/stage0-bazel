"""Build tinycc with mescc.

This is the step that lets the bootstrap leave Scheme behind: tcc-mes is a
real C compiler, written in C, that mescc is just capable enough to compile.

The recipe follows nixpkgs' minimal-bootstrap tinycc/bootstrappable.nix, which
in turn follows live-bootstrap's tcc-0.9.26 step. Four source edits are needed
because mescc cannot compile the code as written; they are applied by Bazel's
own template expansion, since neither `patch` nor `sed` exists yet.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//tools/stage0:files.bzl", "patched_tree")
load("//tools/stage0:mescc.bzl", "mescc_binary", "mescc_object")
load("//tools/tcc:stages.bzl", "tcc_libraries", "tcc_stage")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

# tcc.h includes "config.h" unconditionally. Upstream's ./configure writes it;
# every value it would supply is passed as a -D flag below, so an empty file is
# enough. Upstream's own bootstrap does the same with `catm config.h`.
write_file(
    name = "config_h",
    out = "src/config.h",
    content = [""],
)

# Edits mescc needs to get through the x86-64 code paths, taken verbatim from
# nixpkgs' minimal-bootstrap. Each is a literal string replacement.
TINYCC_PATCHES = {
    # mes libc uses max_align_t, which this tinycc's stddef.h does not define.
    "include/stddef.h": [
        "void *alloca",
        "typedef union { long double ld; long long ll; } max_align_t;\nvoid *alloca",
    ],
    "x86_64-gen.c": [
        # mescc 0.27 has neither working VLAs nor alloca, so this allocation
        # moves to the heap and is deliberately leaked.
        "char _onstack[nb_args], *onstack = _onstack;",
        "char *onstack = tcc_malloc(nb_args);",
        # mescc's libc has no abort.
        "abort();",
        "/* abort(); */",
        # Works around a mescc code generation bug for the compound shift.
        "g(vtop->c.i & (ll ? 63 : 31));",
        "if (ll) g(vtop->c.i & 63); else g(vtop->c.i & 31);",
    ],
    # tinycc only relocates the PLT when linking dynamically, but the x86-64
    # backend emits one regardless, so its got references need relocating too.
    "tccelf.c": [
        "fill_got(s1);",
        "{ fill_got(s1); relocate_plt(s1); }",
    ],
}

# tinycc ships its own stdarg.h, stddef.h and friends, and they are not
# interchangeable with mes's: mes defines va_list as char*, which is the i386
# convention, while tinycc's x86-64 va_list is a struct holding the register
# save area. Anything compiled with the wrong one links fine and then reads
# arguments from the wrong place. This marker names the directory so tinycc's
# headers can be put first on every include path.
write_file(
    name = "src_includedir_marker",
    out = "src/include/TCC_INCLUDEDIR",
    content = ["tinycc include search directory"],
)

filegroup(
    name = "src_include_dir",
    srcs = [":src/include/TCC_INCLUDEDIR"],
)

patched_tree(
    name = "src",
    srcs = ["@tinycc//:tree"],
    prefix = "src",
    substitutions = TINYCC_PATCHES,
)

# Definitions from nixpkgs' tinycc-boot-mes stage.
#
# ONE_SOURCE makes tcc.c include the rest of the compiler, which is what lets
# mescc see the whole program at once. It also turns ST_INLN into
# `static inline`, which mescc's parser rejects, so `inline` is defined away --
# the same trick mes uses for `const` in its own build.
#
# HAVE_LONG_LONG is what makes the 64-bit target work at all: without it
# tinycc's Elf64_* typedefs never appear and mescc fails to parse their uses.
TCC_DEFINES = [
    "BOOTSTRAP=1",
    "ONE_SOURCE=1",
    "inline=",
    "HAVE_LONG_LONG=1",
    "TCC_TARGET_X86_64=1",
    "CONFIG_TCCBOOT=1",
    "CONFIG_TCC_STATIC=1",
    "CONFIG_USE_LIBGCC=1",
    "TCC_MES_LIBC=1",
    "CONFIG_TCC_LIBTCC1_MES=0",
    "CONFIG_TCCDIR=\"\"",
    "CONFIG_SYSROOT=\"\"",
    "CONFIG_TCC_CRTPREFIX=\"{B}\"",
    "CONFIG_TCC_ELFINTERP=\"/mes/loader\"",
    "CONFIG_TCC_LIBPATHS=\"{B}\"",
    "TCC_LIBGCC=\"libc.a\"",
    "TCC_LIBTCC1=\"libtcc1.a\"",
    "TCC_VERSION=\"0.9.28-mes\"",
]

mescc_object(
    name = "tcc_o",
    src = ":src",
    main = "src/tcc.c",
    hdrs = [
        ":config_h",
        "//tools/mes:header_dir",
    ],
    defines = TCC_DEFINES,
    toolchain = "//tools/mes:mescc",
)

# libc+tcc rather than plain libc: tinycc needs the floating point, printf and
# setjmp support only the larger variant provides.
mescc_binary(
    name = "tcc-mes",
    objects = [":tcc_o"],
    libraries = ["c+tcc"],
    toolchain = "//tools/mes:mescc",
)

# tcc reporting its own version proves the binary runs and that its driver,
# preprocessor and option handling all work.
program_output_test(
    name = "tcc_version_test",
    program = ":tcc-mes",
    arguments = ["-v"],
    expected_output = "tcc version 0.9.28-mes (x86_64 Linux)",
)

# The C library rebuilt by the mescc-built tinycc. This is the first stage
# where tinycc compiles anything other than itself.
tcc_libraries(
    name = "tcc-mes_libs",
    tcc = ":tcc-mes",
    mes_headers = "//tools/mes:header_dir",
    libtcc_defines = ["TCC_TARGET_X86_64=1"],
)

# The self-rebuild chain. Each stage compiles tinycc with the stage before it
# and then recompiles the C library with what it just built, so the next stage
# may use language features the previous compiler could not handle. The
# sequence and its flags follow nixpkgs' tinycc/bootstrappable.nix.
TCC_STAGES = [
    ("tcc-boot0", ["HAVE_LONG_LONG=1", "HAVE_SETJMP=1"], ["HAVE_LONG_LONG=1"]),
    ("tcc-boot1", ["HAVE_BITFIELD=1", "HAVE_LONG_LONG=1", "HAVE_SETJMP=1"], ["HAVE_LONG_LONG=1"]),
    (
        "tcc-boot2",
        ["HAVE_BITFIELD=1", "HAVE_FLOAT_STUB=1", "HAVE_LONG_LONG=1", "HAVE_SETJMP=1"],
        ["HAVE_FLOAT_STUB=1", "HAVE_LONG_LONG=1"],
    ),
    (
        "tcc-boot3",
        ["HAVE_BITFIELD=1", "HAVE_FLOAT=1", "HAVE_LONG_LONG=1", "HAVE_SETJMP=1"],
        ["HAVE_FLOAT=1", "HAVE_LONG_LONG=1"],
    ),
    (
        "tcc",
        ["HAVE_BITFIELD=1", "HAVE_FLOAT=1", "HAVE_LONG_LONG=1", "HAVE_SETJMP=1"],
        ["HAVE_FLOAT=1", "HAVE_LONG_LONG=1"],
    ),
]

[
    tcc_stage(
        name = stage,
        prev = ":tcc-mes" if index == 0 else ":" + TCC_STAGES[index - 1][0],
        prev_libs = ":tcc-mes_libs" if index == 0 else ":%s_libs" % TCC_STAGES[index - 1][0],
        src = ":src",
        src_dir_marker = ":src/config.h",
        defines = defines,
        libtcc_defines = libtcc_defines + ["TCC_TARGET_X86_64=1"],
        mes_headers = "//tools/mes:header_dir",
    )
    for index, (stage, defines, libtcc_defines) in enumerate(TCC_STAGES)
]



# The compiler at the end of the chain, self-hosted through five rebuilds.
program_output_test(
    name = "tcc_chain_test",
    program = ":tcc",
    arguments = ["-v"],
    expected_output = "tcc version 0.9.28-mes (x86_64 Linux)",
)
