"""Build tinycc with mescc.

This is the step that lets the bootstrap leave Scheme behind: tcc-mes is a
real C compiler, written in C, that mescc is just capable enough to compile.

The flags and the file list come from upstream's bootstrap.sh. Most of the
definitions are paths baked into the compiler for its own later use rather
than anything needed to build it; CONFIG_TCC_* and TCC_TARGET_* are the ones
that change what tcc compiles into.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//tools/stage0:mescc.bzl", "mescc_binary", "mescc_object")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

# tcc.h includes "config.h" unconditionally. Upstream's ./configure writes it;
# these are the entries configure emits that are not already supplied as -D
# flags below. GCC_MAJOR and GCC_MINOR describe the compiler tcc claims
# compatibility with, not the one building it.
write_file(
    name = "config_h",
    out = "include/config.h",
    content = [
        "/* Generated in place of tinycc's ./configure output. */",
        "#define TCC_VERSION \"0.9.27\"",
        "#define GCC_MAJOR 4",
        "#define GCC_MINOR 3",
    ],
)

# Definitions upstream's bootstrap.sh passes when compiling tinycc under
# mescc. BOOTSTRAP=1 selects the reduced code paths mescc can handle; the
# CONFIG_TCC_* values are the paths the resulting compiler will search.
#
# ONE_SOURCE is deliberately absent. It would make tcc.c include the rest of
# the compiler, which also turns on the `static inline` declarations that
# mescc's parser rejects, so upstream compiles the units separately.
TCC_DEFINES = [
    "BOOTSTRAP=1",
    # mescc has no notion of `inline`, and tcc.h defines helpers as
    # `static inline`. Defining the keyword away is what mes's own build does
    # for `const`, and leaves plain static functions.
    "inline=",
    # i386, not x86_64, even though mes and the resulting binary are 64-bit.
    # The 64-bit code paths reach tinycc's Elf64_* typedefs, which mescc's C
    # parser cannot handle; this is the target upstream and live-bootstrap
    # bootstrap through. tcc-mes is therefore a cross compiler, and moving the
    # chain to a native x86-64 tcc is a later step.
    "TCC_TARGET_I386=1",
    "CONFIG_TCCBOOT=1",
    "CONFIG_TCC_STATIC=1",
    "CONFIG_USE_LIBGCC=1",
    "TCC_MES_LIBC=1",
    "CONFIG_TCCDIR=\"/usr/local/lib/tcc\"",
    "CONFIG_TCC_CRTPREFIX=\"/usr/local/lib:.\"",
    "CONFIG_TCC_ELFINTERP=\"/mes/loader\"",
    "CONFIG_TCC_LIBPATHS=\"/usr/local/lib:.\"",
    "CONFIG_TCC_SYSINCLUDEPATHS=\"/usr/local/include\"",
    "TCC_LIBGCC=\"/usr/local/lib/libc.a\"",
    "TCC_LIBTCC1_MES=\"libtcc1-mes.a\"",
]

# The translation units, in upstream's order. tcc.c is last because it is the
# driver.
TCC_SOURCES = [
    "tccpp",
    "tccgen",
    "tccelf",
    "tccrun",
    "i386-gen",
    "i386-link",
    "i386-asm",
    "tccasm",
    "libtcc",
    "tcc",
]

[
    mescc_object(
        name = name + "_o",
        src = "@tinycc//:%s.c" % name,
        hdrs = [
            "@tinycc//:sources",
            "@mes-m2//:headers",
        ],
        include_dir_markers = [":include/config.h"],
        defines = TCC_DEFINES,
        toolchain = "//tools/mes:mescc",
    )
    for name in TCC_SOURCES
]

# libc+tcc rather than plain libc: tinycc needs the floating point, printf and
# setjmp support that only the larger variant provides.
mescc_binary(
    name = "tcc-mes",
    objects = [":%s_o" % name for name in TCC_SOURCES],
    libraries = ["c+tcc"],
    toolchain = "//tools/mes:mescc",
)

# tcc reports its own version and target, which is enough to prove the binary
# runs and that its driver, preprocessor and option handling all work. That it
# targets i386 while running as x86-64 is deliberate; see the comment on
# TCC_TARGET_I386 above.
program_output_test(
    name = "tcc_version_test",
    program = ":tcc-mes",
    arguments = ["-v"],
    expected_output = "tcc version 0.9.27 (i386 Linux)",
)
