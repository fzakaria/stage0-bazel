"""End-to-end check that tinycc produces working programs.

This is the strongest statement the chain can currently make: a C program
compiled and linked by tinycc, against a C library tinycc itself built, all
descended from the hex0 seed.
"""

load("//tools/stage0:tcc.bzl", "tcc_binary")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

tcc_binary(
    name = "hello",
    srcs = [
        "hello.c",
        "//tools/mes:arch_headers",
        "//tools/mes:header_dir",
    ],
    main = "tests/hello.c",
    include_dir_markers = [
        "//tools/tcc:src/include/TCC_INCLUDEDIR",
        "//tools/mes:include/MESCC_INCLUDEDIR",
        "//tools/mes:headers/include/MES_INCLUDEDIR",
    ],
    libs = "//tools/tcc:tcc-mes_libs",
    tcc = "//tools/tcc:tcc-mes",
)

program_output_test(
    name = "hello_test",
    program = ":hello",
    expected_output = "hello from tcc",
)

# The same program, built by the compiler at the end of the self-rebuild
# chain, using the C library that compiler built.
tcc_binary(
    name = "features",
    srcs = [
        "features.c",
        "//tools/mes:arch_headers",
        "//tools/mes:header_dir",
    ],
    main = "tests/features.c",
    include_dir_markers = [
        "//tools/tcc:src/include/TCC_INCLUDEDIR",
        "//tools/mes:include/MESCC_INCLUDEDIR",
        "//tools/mes:headers/include/MES_INCLUDEDIR",
    ],
    libs = "//tools/tcc:tcc_libs",
    tcc = "//tools/tcc:tcc",
)

program_output_test(
    name = "features_test",
    program = ":features",
    expected_output = "5 20 1234567890123 7",
)

# struct stat's layout has to match the kernel's, because opendir turns one of
# its fields into an allocation size. See dirent.c.
tcc_binary(
    name = "dirent",
    srcs = [
        "dirent.c",
        "//tools/mes:arch_headers",
        "//tools/mes:header_dir",
    ],
    main = "tests/dirent.c",
    include_dir_markers = [
        "//tools/tcc:src/include/TCC_INCLUDEDIR",
        "//tools/mes:include/MESCC_INCLUDEDIR",
        "//tools/mes:headers/include/MES_INCLUDEDIR",
    ],
    libs = "//tools/tcc:tcc_libs",
    tcc = "//tools/tcc:tcc",
)

program_output_test(
    name = "dirent_test",
    program = ":dirent",
    expected_output = "blksize ok\nmtime ok\nopendir ok",
)

# tinycc reports every compile error by longjmp-ing, so this is what decides
# whether the compiler survives a failed ./configure check. See setjmp.c.
tcc_binary(
    name = "setjmp",
    srcs = [
        "setjmp.c",
        "//tools/mes:arch_headers",
        "//tools/mes:header_dir",
    ],
    main = "tests/setjmp.c",
    include_dir_markers = [
        "//tools/tcc:src/include/TCC_INCLUDEDIR",
        "//tools/mes:include/MESCC_INCLUDEDIR",
        "//tools/mes:headers/include/MES_INCLUDEDIR",
    ],
    libs = "//tools/tcc:tcc_libs",
    tcc = "//tools/tcc:tcc",
)

program_output_test(
    name = "setjmp_test",
    program = ":setjmp",
    expected_output = "value ok\nframe ok",
)

# qsort decides more than sorting here: tinycc sorts a switch statement's
# cases and binary-searches the result, so a wrong qsort miscompiles every
# wide switch. See qsort.c.
tcc_binary(
    name = "qsort",
    srcs = [
        "qsort.c",
        "//tools/mes:arch_headers",
        "//tools/mes:header_dir",
    ],
    main = "tests/qsort.c",
    include_dir_markers = [
        "//tools/tcc:src/include/TCC_INCLUDEDIR",
        "//tools/mes:include/MESCC_INCLUDEDIR",
        "//tools/mes:headers/include/MES_INCLUDEDIR",
    ],
    libs = "//tools/tcc:tcc_libs",
    tcc = "//tools/tcc:tcc",
)

program_output_test(
    name = "qsort_test",
    program = ":qsort",
    expected_output = "qsort ok\nswitch ok",
)
