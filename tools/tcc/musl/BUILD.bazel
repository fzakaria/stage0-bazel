"""tinycc rebuilt against musl.

Up to here every compiler in the chain has produced programs linked against
mes-libc, which is missing too much to build GCC. This is the same tinycc
source compiled and linked against musl instead, so that everything after it
-- binutils, and then GCC -- is built against a complete C library.

Two rounds, as with the mes-libc tinycc: the first is built by the previous
compiler, the second by the first. Only the second is used.

The recipe is nixpkgs' minimal-bootstrap tinycc/musl.nix. It is driven by a
shell script rather than by the tcc_binary rule the earlier stages use,
because musl's headers and libraries are two directories inside one installed
tree and a Bazel rule cannot name a subdirectory of a TreeArtifact.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//tools/pkg:defs.bzl", "installed_program")
load("//tools/stage0:files.bzl", "tool_dir")
load("//tools/stage0:kaem.bzl", "kaem_run")
load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

# What this tinycc is compiled with, and what it bakes in as its own search
# paths. {B} is whatever -B the compiler is invoked with, so the installed
# compiler finds musl by being pointed at it rather than by an absolute path
# recorded at build time.
DEFINES = [
    "TCC_TARGET_X86_64=1",
    "CONFIG_TCCDIR=\\\"\\\"",
    "CONFIG_TCC_CRTPREFIX=\\\"{B}\\\"",
    "CONFIG_TCC_SYSINCLUDEPATHS=\\\"{B}/include\\\"",
    "CONFIG_TCC_LIBPATHS=\\\"{B}\\\"",
    "CONFIG_TCC_ELFINTERP=\\\"/musl/loader\\\"",
    "CONFIG_TCC_PREDEFS=1",
    "CONFIG_TCC_SEMLOCK=0",
    "CONFIG_TCC_STATIC=1",
    "CONFIG_USE_LIBGCC=1",
    "ONE_SOURCE=1",
    "TCC_LIBTCC1=\\\"libtcc1.a\\\"",
    "HAVE_BITFIELD=1",
    "HAVE_FLOAT=1",
    "HAVE_LONG_LONG=1",
    "HAVE_SETJMP=1",
]

_DEFINE_FLAGS = " ".join(["-D " + define for define in DEFINES])

write_file(
    name = "build_script",
    out = "tcc_musl_build.sh",
    content = [
        "# Generated by tools/tcc/musl/BUILD.bazel.",
        "set -eu",
        "",
        "# Paths reaching this script are relative to the execroot. Nothing",
        "# below changes directory, but tcc records some of them, so absolute",
        "# paths keep the meaning obvious.",
        "root=\"$PWD\"",
        "out=\"$root/$out\"",
        "musl=\"$root/$musl\"",
        "src=\"$root/$src\"",
        "tccdefs=\"$root/$tccdefs\"",
        "",
        "mkdir -p \"$out/bin\" \"$out/lib\"",
        "",
        "# One directory holding everything a link against musl needs. tinycc",
        "# keeps only the last -B it is given rather than accumulating them,",
        "# so musl's runtime and libtcc1.a have to sit together.",
        "mkdir -p libs",
        "cp $musl/lib/*.a libs",
        "cp $musl/lib/*.o libs",
        "",
        "# libtcc1 holds the helper routines tinycc emits calls to -- the",
        "# long double conversions among them -- so it has to exist before",
        "# anything can be linked. It is compiled here by the previous",
        "# compiler: the file is arithmetic support, with no libc of its own.",
        " ".join([
            "tcc -c -o libtcc1-boot.o",
            "-D TCC_TARGET_X86_64=1 -D HAVE_CONFIG_H=1",
            "-I $src -I $src/include -I $musl/include",
            "$src/lib/libtcc1.c",
        ]),
        # alloca is not in libtcc1.c: current tinycc keeps it in assembly, and
        # a program that calls alloca fails to link without it.
        "tcc -c -o alloca-boot.o -D TCC_TARGET_X86_64=1 $src/lib/alloca.S",
        "tcc -ar cr libs/libtcc1.a libtcc1-boot.o alloca-boot.o",
        "",
        "# Round one: the mes-libc tinycc builds a tinycc that links against",
        "# musl. The compiler doing the work still needs its own headers,",
        "# which is why both include directories appear.",
        " ".join([
            "tcc -static -o tcc-musl-boot",
            _DEFINE_FLAGS,
            "-I $src",
            "-I $tccdefs",
            "-I $musl/include",
            "-B libs",
            "$src/tcc.c",
        ]),
        "",
        "# Round two: the musl tinycc rebuilds itself. This is the compiler",
        "# that everything after this point uses.",
        " ".join([
            "./tcc-musl-boot -static -o tcc-musl",
            _DEFINE_FLAGS,
            "-I $src",
            "-I $tccdefs",
            "-I $musl/include",
            "-B libs",
            "$src/tcc.c",
        ]),
        "",
        "# The runtime library, rebuilt by the compiler that will ship it.",
        " ".join([
            "./tcc-musl -c -o libtcc1.o",
            "-D TCC_TARGET_X86_64=1 -D HAVE_CONFIG_H=1",
            "-I $src -I $musl/include -B libs",
            "$src/lib/libtcc1.c",
        ]),
        "./tcc-musl -c -o alloca.o -D TCC_TARGET_X86_64=1 $src/lib/alloca.S",
        "rm -f libtcc1.a",
        "./tcc-musl -ar cr libtcc1.a libtcc1.o alloca.o",
        "",
        "# Install. musl's own libraries and headers travel with the compiler",
        "# so that a single -B is enough for anything built by it.",
        "cp tcc-musl \"$out/bin/tcc\"",
        "chmod 555 \"$out/bin/tcc\"",
        "cp libtcc1.a \"$out/lib/libtcc1.a\"",
        "cp $musl/lib/*.a \"$out/lib\"",
        "cp $musl/lib/*.o \"$out/lib\"",
        "cp -r $musl/include \"$out/include\"",
        "",
    ],
)

write_file(
    name = "kaem_script",
    out = "tcc_musl.kaem",
    content = [
        "# kaem cannot express any of the above, so it only hands over.",
        "mkdir -p ${out}",
        "bash ${driver}",
        "",
    ],
)

kaem_run(
    name = "tcc-musl",
    script = "tcc_musl.kaem",
    substitutions = {"driver": "tcc_musl_build.sh"},
    directory_substitutions = {
        "musl": "//tools/pkg/musl:musl",
        "src": "//tools/tcc/current:src",
        "tccdefs": "//tools/tcc/current:tccdefs",
    },
    srcs = [
        "//tools/tcc/current:src",
        # tcc.h includes "config.h" unconditionally. It is generated rather
        # than patched in, so it is not part of the source tree above even
        # though it lands beside it.
        "//tools/tcc/current:config_h",
        "//tools/pkg/musl:musl",
    ],
    tools = [
        ":bootstrap_tcc",
        "//tools/pkg/coreutils:bin",
        "//tools/pkg/bash:bin",
        "//tools/mescc-tools-extra:bin",
    ],
)

tool_dir(
    name = "bootstrap_tcc",
    tools = {"tcc": "//tools/tcc/current:tcc"},
)

installed_program(
    name = "tcc",
    package = ":tcc-musl",
    program = "tcc",
)

tool_dir(
    name = "bin",
    tools = {"tcc": ":tcc"},
)

program_output_test(
    name = "tcc_musl_version_test",
    program = ":tcc",
    arguments = ["-v"],
    expected_output = "tcc version 0.9.28rc (x86_64 Linux)",
)
