"""A registered C/C++ toolchain, built by this repository from the hex0 seed.

Registering this makes cc_library, cc_binary and cc_test work with a compiler
whose whole ancestry is in this repository. A module that depends on
stage0-bazel registers it for itself, because a registration in one module
does not reach another:

    bazel_dep(name = "stage0-bazel", version = "0.1.0")
    register_toolchains("@stage0-bazel//toolchain:cc")

The compiler is GCC 10.4.0 and the C library is musl 1.2.6, both built here;
see //tools/pkg/gcc/latest and //tools/pkg/musl. Programs come out statically
linked, because there is no dynamic loader in this world to name.

GCC 10 gives C++17. It is itself built by the GCC 4.6.4 the chain reaches
first, which is built by tinycc, which is built by mes, which is built by the
357-byte hex0 seed; //tools/pkg/gcc/latest says why the ladder has that shape.
"""

load("//tools/pkg:defs.bzl", "installed_file")
load(":cc_toolchain_config.bzl", "stage0_cc_toolchain_config")
load(":clang_toolchain_config.bzl", "exec_files", "stage0_clang_toolchain_config")

package(
    default_visibility = ["//visibility:public"],
)

# The compiler tree, the C library and the binary utilities. Everything the
# toolchain runs or reads comes out of these three.
#
# GCC 10.4 rather than the 4.6 that built it: 4.6 gives C++98 and part of
# C++0x, which is enough to prove the chain and not enough to write anything
# current against. See //tools/pkg/gcc/latest.
GCC_TREE = "//tools/pkg/gcc/latest:gcc_latest_dist"

GCC_VERSION = "10.4.0"

MUSL_TREE = "//tools/pkg/musl:musl4"

LINUX_HEADERS_TREE = "//tools/pkg/linux-headers:linux_headers"

BINUTILS_TREE = "//tools/pkg/binutils:binutils"

# An action_config names its tool by artifact, and a file inside a
# TreeArtifact cannot be named. The driver is therefore extracted; it still
# needs the tree beside it, because cc1plus and collect2 are found through
# the -B prefixes the configuration adds rather than beside the driver.
installed_file(
    name = "g++",
    package = GCC_TREE,
    path = "bin/g++",
)

# And the C driver. g++ compiles a .c file as C++, which is a different
# language; see cc_toolchain_config.bzl.
installed_file(
    name = "gcc",
    package = GCC_TREE,
    path = "bin/gcc",
)

stage0_cc_toolchain_config(
    name = "config",
    ar = "//tools/pkg/binutils:ar",
    binutils_tree = BINUTILS_TREE,
    c_driver = ":gcc",
    driver = ":g++",
    gcc_tree = GCC_TREE,
    gcc_version = GCC_VERSION,
    linux_headers_tree = LINUX_HEADERS_TREE,
    musl_tree = MUSL_TREE,
    strip = "//tools/pkg/binutils:strip",
)

# Every input any toolchain action can need. The trees are listed whole: the
# compiler reads its own headers and libraries out of them at run time, and
# which files it touches depends on the source being compiled. The extracted
# binaries are listed as well, because an action_config names one of those
# rather than a path inside a tree.
filegroup(
    name = "all_files",
    srcs = [
        ":g++",
        ":gcc",
        BINUTILS_TREE,
        GCC_TREE,
        LINUX_HEADERS_TREE,
        MUSL_TREE,
        "//tools/pkg/binutils:ar",
        "//tools/pkg/binutils:ld",
        "//tools/pkg/binutils:nm",
        "//tools/pkg/binutils:objdump",
        "//tools/pkg/binutils:strip",
    ],
)

cc_toolchain(
    name = "cc_toolchain",
    all_files = ":all_files",
    ar_files = ":all_files",
    compiler_files = ":all_files",
    dwp_files = ":all_files",
    linker_files = ":all_files",
    objcopy_files = ":all_files",
    strip_files = ":all_files",
    supports_param_files = 0,
    toolchain_config = ":config",
    toolchain_identifier = "stage0-gcc-" + GCC_VERSION,
)

toolchain(
    name = "cc",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# The clang toolchain.
#
# Not registered by default, and deliberately: the GCC toolchain above is what
# builds clang, so making clang the default would be a cycle. A module that
# wants it registers it instead of //toolchain:cc --
#
#     register_toolchains("@stage0-bazel//toolchain:clang")
#
# -- or passes --extra_toolchains for one build. Building anything with it
# requires --config=llvm, because that is where the flags LLVM needs live.
CLANG_VERSION = "22.1.8"

# Which compiler a platform asks for.
#
# This exists to keep clang out of the execution configuration, and it is not
# a preference -- it is what stops the graph from being circular. clang's own
# build runs clang-tblgen to generate some of the headers that the clang
# toolchain then names, so a clang toolchain that also applied to the tools
# being built for the host would depend on itself:
#
#     clang-tblgen -> current_cc_toolchain -> clang_cc_toolchain
#       -> clang_config -> builtin_headers_gen -> clang-tblgen
#
# The constraint appears only on the target platform below. Anything built for
# the execution platform -- every tool in the LLVM build, including
# clang-tblgen -- sees the plain host platform, does not satisfy this, and
# resolves to the GCC toolchain that built clang in the first place.
constraint_setting(name = "cc_backend")

constraint_value(
    name = "clang_backend",
    constraint_setting = ":cc_backend",
)

platform(
    name = "clang_platform",
    parents = ["@platforms//host"],
    constraint_values = [":clang_backend"],
)

stage0_clang_toolchain_config(
    name = "clang_config",
    # Building any of these builds clang; see the note on :clang above.
    tags = ["manual"],
    ar = "//tools/pkg/binutils:ar",
    binutils_tree = BINUTILS_TREE,
    builtin_headers = "@llvm-project//clang:builtin_headers_gen",
    clang = "@llvm-project//clang:clang",
    clang_version = CLANG_VERSION,
    gcc_tree = GCC_TREE,
    gcc_version = GCC_VERSION,
    linux_headers_tree = LINUX_HEADERS_TREE,
    lld = "@llvm-project//lld:ld.lld",
    musl_tree = MUSL_TREE,
    strip = "//tools/pkg/binutils:strip",
)

# GCC's tree is here for libstdc++ and libgcc.a, not for its compilers: clang
# reads the C++ headers out of it and links against the runtime in it.
exec_files(
    name = "clang_all_files",
    # Building any of these builds clang; see the note on :clang above.
    tags = ["manual"],
    srcs = [
        "@llvm-project//clang:builtin_headers_gen",
        "@llvm-project//clang:clang",
        "@llvm-project//lld:ld.lld",
        BINUTILS_TREE,
        GCC_TREE,
        LINUX_HEADERS_TREE,
        MUSL_TREE,
        "//tools/pkg/binutils:ar",
        "//tools/pkg/binutils:strip",
    ],
)

cc_toolchain(
    name = "clang_cc_toolchain",
    # Building any of these builds clang; see the note on :clang above.
    tags = ["manual"],
    all_files = ":clang_all_files",
    ar_files = ":clang_all_files",
    compiler_files = ":clang_all_files",
    dwp_files = ":clang_all_files",
    linker_files = ":clang_all_files",
    objcopy_files = ":clang_all_files",
    strip_files = ":clang_all_files",
    supports_param_files = 0,
    toolchain_config = ":clang_config",
    toolchain_identifier = "stage0-clang-" + CLANG_VERSION,
)

toolchain(
    name = "clang",
    # Building any of these builds clang; see the note on :clang above.
    tags = ["manual"],
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":clang_backend",
    ],
    toolchain = ":clang_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
