"""Proof that the registered toolchain compiles C++.

These are ordinary cc_* rules. Nothing here mentions the bootstrap: the point
is that a caller writes the rules they would write anyway, and toolchain
resolution finds a compiler descended from the hex0 seed.
"""

load("//tools/verify:run_test.bzl", "program_output_test")

package(
    default_visibility = ["//visibility:public"],
)

cc_binary(
    name = "hello",
    srcs = ["hello.cc"],
)

program_output_test(
    name = "hello_test",
    program = ":hello",
    expected_output = "hello world \nlargest 11\ncaught largest of nothing",
)

# A library, so that the archiver runs. A single-file cc_binary never reaches
# it, and `ar` writing a usable index is a separate thing from the compiler
# working.
cc_library(
    name = "greeting",
    srcs = ["greeting.cc"],
    hdrs = ["greeting.h"],
)

cc_test(
    name = "greeting_test",
    srcs = ["greeting_test.cc"],
    deps = [":greeting"],
)

# The upgrade to GCC 10, asserted rather than described. Every construct in
# the source is C++17, so a toolchain still pointed at 4.6 does not fail this
# at run time -- it fails to compile it. GCC 10 defaults to gnu++14, hence the
# explicit standard.
#
# A cc_binary and a program_output_test rather than a cc_test, because the
# audits in //tools/verify are not test rules and so cannot depend on a
# testonly target. hello is split the same way and for the same reason.
cc_binary(
    name = "cxx17",
    srcs = ["cxx17.cc"],
    copts = ["-std=c++17"],
)

program_output_test(
    name = "cxx17_test",
    program = ":cxx17",
    expected_output = "c++17 ok",
)
