# Bazel configuration for stage0-bazel.
#
# The central invariant of this repository is that nothing in the bootstrap
# graph may touch a C/C++ toolchain supplied by the host. Every flag below
# exists to make that invariant hold and to make a violation loud.

# Refuse to auto-detect a host C++ toolchain. Bazel still creates the
# @local_config_cc repository, but every tool in it becomes a stub that
# fails the action instead of silently shelling out to /usr/bin/gcc.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Toolchain resolution (rather than the legacy --crosstool_top path) is the
# only way this repository's cc_toolchain can ever be selected.
build --incompatible_enable_cc_toolchain_resolution

# Do not let the host environment leak into actions: a fixed PATH means an
# action that reaches for `cc`, `as` or `ld` fails rather than picking up
# whatever the developer happens to have installed.
build --incompatible_strict_action_env

# Bootstrap actions are pure file-in/file-out; none of them need the network.
build --sandbox_default_allow_network=false

# The stage0 binaries are freestanding static ELF executables. Keep the
# runfiles tree simple so the shape of what we ship is easy to reason about.
build --nolegacy_external_runfiles

# Surface the full command line of a failing bootstrap action; debugging a
# hex2 or M1 invocation is impossible from the summary alone.
build --verbose_failures
test --test_output=errors

# Tests are exempt from the no-host-tools rule: Bazel's own test runner is a
# bash script, and the audits live in test targets rather than in the graph
# they audit. Give tests the real PATH so that runner can be found.
test --test_env=PATH

# //tools/verify:no_native_toolchain_test asserts the same invariant at
# analysis time by walking the bootstrap graph; see that package for details.

# Remote execution and caching via BuildBuddy, for the LLVM build only.
#
# Deliberately behind a --config rather than on by default. The bootstrap
# proper is the claim this repository makes -- hex0 to a C++ compiler, on your
# machine, from sources you can read -- and running it on someone else's
# workers makes that claim rest on their container image instead. LLVM is
# different: it is an ordinary Bazel build of an ordinary C++ project, it is
# plausibly hours of compute, and nothing about it is load-bearing for trust.
#
#     bazelisk build --config=remote @llvm-project//clang
build:remote --bes_results_url=https://app.buildbuddy.io/invocation/
build:remote --bes_backend=grpcs://remote.buildbuddy.io
common:remote --remote_cache=grpcs://remote.buildbuddy.io
common:remote --remote_timeout=10m
common:remote --remote_executor=grpcs://remote.buildbuddy.io

# The BuildBuddy API key is a credential and does not belong in a tracked
# file. It lives in .bazelrc.local, which .gitignore excludes:
#
#     common --remote_header=x-buildbuddy-api-key=<key>
try-import %workspace%/.bazelrc.local

# Building LLVM.
#
# Behind a --config because LLVM is not part of the bootstrap and is far and
# away the longest thing here; `bazel test //...` should not wait on it.
#
#     bazelisk build --config=llvm @llvm-project//clang:clang
#
# The flags are LLVM's own generic_gcc set from utils/bazel/.bazelrc, which
# does not reach us -- that file belongs to their repository and this build
# consumes their sources through an http_archive. Their .bazelrc also sets
# --force_pic, --features=layering_check and --process_headers_in_dependencies,
# which are deliberately not copied: this toolchain declares no PIC support
# and has no module maps, and none of the three is needed to produce a working
# compiler.
build:llvm --cxxopt=-std=c++17 --host_cxxopt=-std=c++17
build:llvm --copt=-Wno-deprecated --host_copt=-Wno-deprecated
build:llvm --copt=-Wno-unused-parameter --host_copt=-Wno-unused-parameter
build:llvm --copt=-Wno-comment --host_copt=-Wno-comment
build:llvm --copt=-Wno-maybe-uninitialized --host_copt=-Wno-maybe-uninitialized
build:llvm --copt=-Wno-misleading-indentation --host_copt=-Wno-misleading-indentation
build:llvm --cxxopt=-Wno-class-memaccess --host_cxxopt=-Wno-class-memaccess

# Static only, which is what this toolchain can do anyway.
build:llvm --dynamic_mode=off

# zlib yes, zstd no.
#
# Both are optional in LLVM and the first instinct was to drop both, on the
# grounds that a graph you can account for is the point of this repository.
# That was wrong about zlib. binutils writes GCC's debug sections compressed,
# and a linker without zlib cannot read one:
#
#     libstdc++.a(lt4-string-inst.o):(.debug_info) is compressed with
#     ELFCOMPRESS_ZLIB, but lld is not built with zlib support
#
# The alternative was to build GCC's libraries with no debug info at all,
# which is a worse trade: it costs every user of this toolchain the ability
# to step into libstdc++, to save one small library that GCC's own output
# requires anyway.
#
# zstd stays off. It answers ELFCOMPRESS_ZSTD, which nothing in this chain
# emits, so it would be carried for nothing.
build:llvm --@llvm-project//third-party:llvm_enable_zstd=false

# The shell LLVM's genrules run.
#
# One host program, and only one. A genrule runs a shell, and Bazel wants that
# shell as an absolute system path: sh_toolchain's `path` is a mandatory
# string, and the shell is not a declared input of the action, so it cannot be
# a build artifact the way every other tool here is. On NixOS Bazel's default
# of /bin/bash does not even exist:
#
#     execvp(/bin/bash, ...): No such file or directory
#
# shell.nix sets BAZEL_SH, which is where the path comes from; there is
# nothing to configure here. //:trust-report names it beside the hex0 seed
# rather than passing over it.
#
# Nothing else is borrowed. PATH inside a genrule stays /bin:/usr/bin:
# /usr/local/bin, which on this host is empty, so every genrule on the path to
# clang either uses bash builtins or takes its tools from the bootstrap
# through its `tools` attribute -- clang's builtin-header staging takes mkdir
# and cp that way. See third_party/llvm-no-python.patch and
# third_party/zlib-ng-no-host-tools.patch.
#
# Those genrules run here rather than on a remote worker, because BAZEL_SH
# names this machine's nix store and a BuildBuddy container does not have it.
# They only write small files, so nothing is lost.
build:llvm --modify_execution_info=Genrule=+no-remote
