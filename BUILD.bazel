"""Stable labels for the binaries this bootstrap produces.

Downstream modules should depend on these aliases rather than on the phase
packages: which phase a tool comes from is an implementation detail of the
bootstrap and moves as the chain grows.

The C/C++ toolchain is registered here too, for a reason explained beside it.
"""

load("//tools/pkg:defs.bzl", "installed_file")
load("//toolchain:cc_toolchain_config.bzl", "stage0_cc_toolchain_config")

package(
    default_visibility = ["//visibility:public"],
)

alias(
    name = "hex2",
    actual = "//tools/stage0/phase10:hex2",
)

alias(
    name = "M1",
    actual = "//tools/stage0/phase9:M1",
)

alias(
    name = "blood-elf",
    actual = "//tools/stage0/phase13:blood-elf",
)

alias(
    name = "get_machine",
    actual = "//tools/stage0/phase14:get_machine",
)

alias(
    name = "M2-Planet",
    actual = "//tools/stage0/phase15:M2-Planet",
)

alias(
    name = "M2-Mesoplanet",
    actual = "//tools/stage0/phase12:M2-Mesoplanet",
)

alias(
    name = "kaem",
    actual = "//tools/stage0/phase11:kaem",
)

alias(
    name = "mes",
    actual = "//tools/mes:mes",
)

# The mescc toolchain to pass to mescc_object, mescc_library and mescc_binary.
alias(
    name = "mescc",
    actual = "//tools/mes:mescc",
)

# tinycc, compiled by mescc. Targets i386; see tools/tcc/BUILD.bazel.
alias(
    name = "tcc-mes",
    actual = "//tools/tcc:tcc-mes",
)

# A statement of what the build trusts: how many inputs were built here, how
# many came from hash-pinned archives, and which binaries were taken on faith.
alias(
    name = "attestation",
    actual = "//tools/verify:attestation",
)

# Building this asserts that nothing in the bootstrap graph runs a program the
# graph did not build. Run it in CI.
alias(
    name = "trust-report",
    actual = "//tools/verify:no_native_toolchain",
)

alias(
    name = "tcc",
    actual = "//tools/tcc:tcc",
)

alias(
    name = "make",
    actual = "//tools/pkg/gnumake:make",
)

alias(
    name = "patch",
    actual = "//tools/pkg/gnupatch:patch",
)

# ---------------------------------------------------------------------------
# The C/C++ toolchain.
#
# Registering this makes cc_library, cc_binary and cc_test work with a
# compiler whose whole ancestry is in this repository. A module that depends
# on stage0-bazel registers it for itself, because a registration in one
# module does not reach another:
#
#     bazel_dep(name = "stage0-bazel", version = "0.1.0")
#     register_toolchains("@stage0-bazel//:cc")
#
# The compiler is GCC 4.6.4 and the C library is musl 1.2.6, both built here;
# see tools/pkg/gcc/cxx and tools/pkg/musl. Programs come out statically
# linked, because there is no dynamic loader in this world to name.
#
# These targets are in the root package rather than in a package of their
# own, and they have to be: a cc_toolchain's tool paths are resolved against
# the package holding it, every tool here is a build artifact under
# bazel-out/, and Bazel rejects the ../ that reaching bazel-out from any
# other package would need.

# The compiler tree, the C library and the binary utilities. Everything the
# toolchain runs or reads comes out of these three.
GCC_TREE = "//tools/pkg/gcc/cxx:gcc_cxx_dist"

MUSL_TREE = "//tools/pkg/musl:musl3"

BINUTILS_TREE = "//tools/pkg/binutils:binutils"

# A tool path names one file, and a file inside a TreeArtifact cannot be
# named. The driver is therefore extracted; it still needs the tree beside
# it, because cc1plus and collect2 are found through the -B prefixes the
# configuration adds rather than beside the driver.
installed_file(
    name = "g++",
    package = GCC_TREE,
    path = "bin/g++",
)

stage0_cc_toolchain_config(
    name = "cc_config",
    gcc_tree = GCC_TREE,
    musl_tree = MUSL_TREE,
    binutils_tree = BINUTILS_TREE,
    driver = ":g++",
    ar = "//tools/pkg/binutils:ar",
    ld = "//tools/pkg/binutils:ld",
    nm = "//tools/pkg/binutils:nm",
    objdump = "//tools/pkg/binutils:objdump",
    strip = "//tools/pkg/binutils:strip",
)

# Every input any toolchain action can need. The trees are listed whole: the
# compiler reads its own headers and libraries out of them at run time, and
# which files it touches depends on the source being compiled. The extracted
# binaries are listed as well, because a tool path names one of those rather
# than a path inside a tree.
filegroup(
    name = "cc_toolchain_files",
    srcs = [
        ":g++",
        BINUTILS_TREE,
        GCC_TREE,
        MUSL_TREE,
        "//tools/pkg/binutils:ar",
        "//tools/pkg/binutils:ld",
        "//tools/pkg/binutils:nm",
        "//tools/pkg/binutils:objdump",
        "//tools/pkg/binutils:strip",
    ],
)

cc_toolchain(
    name = "cc_toolchain",
    all_files = ":cc_toolchain_files",
    ar_files = ":cc_toolchain_files",
    compiler_files = ":cc_toolchain_files",
    dwp_files = ":cc_toolchain_files",
    linker_files = ":cc_toolchain_files",
    objcopy_files = ":cc_toolchain_files",
    strip_files = ":cc_toolchain_files",
    supports_param_files = 0,
    toolchain_config = ":cc_config",
    toolchain_identifier = "stage0-gcc-4.6.4",
)

toolchain(
    name = "cc",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
