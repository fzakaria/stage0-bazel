# LLVM, for clang and lld.
#
# Not a bazel_dep: the Bazel build lives in utils/bazel inside the LLVM
# source tree and is not published to any registry. The documented way in is
# the one utils/bazel/examples/http_archive uses -- fetch the source, then
# let llvm_configure symlink the overlay's BUILD files over it.
#
# llvm_configure has only a `targets` attribute and no patch hook, which is
# why the Python patch goes on the archive rather than on the configure.
LLVM_VERSION = "22.1.8"

http_archive(
    name = "llvm-raw",
    build_file_content = "# empty",
    sha256 = "ad18b70e287954c3d62bc7e0b86e7b7af2adf87bcfce21c15fe717f101d7aace",
    url = "https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-%s.tar.gz" % LLVM_VERSION,
    strip_prefix = "llvm-project-llvmorg-%s" % LLVM_VERSION,
    patches = [
        "//third_party:llvm-no-python.patch",
        "//third_party:llvm-musl.patch",
        "//third_party:llvm-version-suffix.patch",
    ],
    patch_args = ["-p1"],
)

llvm_configure = use_repo_rule("@llvm-raw//utils/bazel:configure.bzl", "llvm_configure")

# X86 only. The default is every backend LLVM has, and each one is a large
# amount of TableGen and generated code that this toolchain would have to
# compile for nothing -- the compiler is being built to run here and target
# here.
llvm_configure(
    name = "llvm-project",
    targets = ["X86"],
)
