"stage0-bazel"

module(name = "stage0-bazel")

bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "platforms", version = "0.0.11")

# What LLVM's Bazel overlay declares for itself.
#
# The overlay is a module -- utils/bazel/MODULE.bazel says
# module(name = "llvm-project-overlay") -- but it is not published to the BCR,
# so it cannot be a bazel_dep. It is brought in as a repository rule instead
# (see llvm_configure below), and a repository this module creates resolves
# its dependencies against this module's repo names. So these have to be
# declared here, spelled the way the overlay's own BUILD files spell them.
#
# protobuf, nanobind and vulkan_headers are deliberately absent: only MLIR and
# the Python bindings reach them, and clang and lld build neither.
bazel_dep(name = "rules_cc", version = "0.2.11")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "zlib-ng", version = "2.0.7", repo_name = "llvm_zlib")

# zlib-ng as the registry ships it shells out to cp, and cannot be included
# with angle brackets, which is the only way LLVM includes it. See the patch.
single_version_override(
    module_name = "zlib-ng",
    patch_strip = 1,
    patches = ["//third_party:zlib-ng-no-host-tools.patch"],
)
bazel_dep(name = "zstd", version = "1.5.7", repo_name = "llvm_zstd")

# The C/C++ toolchain this repository bootstraps. A module depending on
# stage0-bazel has to register it for itself -- registrations do not
# propagate across modules. //toolchain says the rest.
register_toolchains("//toolchain:cc")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Upstream source tarballs stay compressed: the bootstrap unpacks them with
# its own ungz and untar rather than with Bazel's extractor, so the tools
# doing the unpacking are themselves part of the audited graph.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

