# tinycc, already carrying the mes bootstrap patches on its mes-0.27 branch.
# Taking it pre-patched means the bootstrap needs no `patch` tool.
http_archive(
    name = "tinycc",
    build_file = "//third_party:tinycc.BUILD",
    sha256 = "d7a2411890130163fe94fca53a2dfe9688e976fd12479a6acb1395d8f895c740",
    url = "https://gitlab.com/janneke/tinycc/-/archive/ea3900f6d5e71776c5cfabcabee317652e3a19ee/tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee.tar.gz",
    strip_prefix = "tinycc-ea3900f6d5e71776c5cfabcabee317652e3a19ee",
)

# Current tinycc. The bootstrappable fork above is only capable enough to be
# compiled by mescc; this is what the chain switches to as soon as it has a
# compiler that can build it, and it is what every package is built with.
http_archive(
    name = "tinycc-current",
    build_file = "//third_party:tinycc-current.BUILD",
    sha256 = "311baaab74ca71f21a86d51676101c621a838863e40234bc51332c0c4fbf8c65",
    url = "https://repo.or.cz/tinycc.git/snapshot/cb41cbfe717e4c00d7bb70035cda5ee5f0ff9341.tar.gz",
    strip_prefix = "tinycc-cb41cbf",
)

# The C99 parser mescc is written against. Mes ships only two nyacc compat
# shims, not the parser itself, so mescc cannot run without this.
http_archive(
    name = "nyacc",
    build_file = "//third_party:nyacc.BUILD",
    sha256 = "f36e4fb7dd524dc3f4b354d3d5313f69e7ce5a6ae93711e8cf6d51eaa8d2b318",
    url = "https://download-mirror.savannah.gnu.org/releases/nyacc/nyacc-1.00.2.tar.gz",
    strip_prefix = "nyacc-1.00.2",
)
# GNU patch. 2.6 and later use interfaces mes-libc does not provide, which is
# why the bootstrap stops at 2.5.9; the version choice is nixpkgs'.
http_file(
    name = "gnupatch-src",
    sha256 = "ecb5c6469d732bcf01d6ec1afe9e64f1668caba5bfdb103c28d7f537ba3cdb8a",
    url = "https://mirror.team-cymru.com/gnu/patch/patch-2.5.9.tar.gz",
    downloaded_file_path = "patch-2.5.9.tar.gz",
)

# GNU make. Everything past this point has a Makefile, so this is the last
# package whose source list has to be transcribed by hand.
http_file(
    name = "gnumake-src",
    sha256 = "dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3",
    url = "https://mirror.team-cymru.com/gnu/make/make-4.4.1.tar.gz",
    downloaded_file_path = "make-4.4.1.tar.gz",
)

# bash 2.05b. Later releases need locale support that mes-libc does not have;
# this is the version live-bootstrap and nixpkgs bootstrap through.
http_file(
    name = "bash-src",
    sha256 = "ba03d412998cc54bd0b0f2d6c32100967d3137098affdc2d32e6e7c11b163fe4",
    url = "https://mirror.team-cymru.com/gnu/bash/bash-2.05b.tar.gz",
    downloaded_file_path = "bash-2.05b.tar.gz",
)

# GNU sed 4.0.9, the version live-bootstrap and nixpkgs bootstrap through.
# Later releases depend on gnulib modules that mes-libc cannot satisfy.
http_file(
    name = "gnused-src",
    sha256 = "c365874794187f8444e5d22998cd5888ffa47f36def4b77517a808dec27c0600",
    url = "https://mirror.team-cymru.com/gnu/sed/sed-4.0.9.tar.gz",
