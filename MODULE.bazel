"stage0-bazel"

module(name = "stage0-bazel")

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.11")

# The C/C++ toolchain this repository bootstraps. A module depending on
# stage0-bazel has to register it for itself -- registrations do not
# propagate across modules -- which is what //toolchain documents.
register_toolchains("//:cc")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Upstream source tarballs stay compressed: the bootstrap unpacks them with
# its own ungz and untar rather than with Bazel's extractor, so the tools
# doing the unpacking are themselves part of the audited graph.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

